          }
        }
      }
    },
    "Tankard Updates": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard-Updates"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour de Tankard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizaciones de Tankard"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankardのアップデート"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 更新"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizações do Tankard"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamenti di Tankard"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 업데이트"
          }
        }
      }
    },
    "Tankard asks for the password in a dialog and passes it only to sudo; it never stores it. If you cancel, the sheet shows the command for Terminal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard fragt in einem Dialog danach und gibt es nur an sudo weiter; es wird nie gespeichert. Bei Abbrechen zeigt das Fenster den Befehl fürs Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard le demande dans une fenêtre et le transmet uniquement à sudo ; il ne le conserve jamais. Si vous annulez, la feuille affiche la commande pour Terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard la pide en un cuadro de diálogo y solo se la pasa a sudo; nunca la guarda. Si cancelas, la hoja muestra el comando para Terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankardはダイアログでパスワードを尋ね、sudoにのみ渡します。保存することはありません。キャンセルすると、シートにターミナル用のコマンドが表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 会在对话框中询问密码，并只把它交给 sudo；从不存储。如果取消，表单会显示用于“终端”的命令。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard pede a senha em uma caixa de diálogo e a passa apenas para o sudo; nunca a guarda. Se você cancelar, a janela mostra o comando para o Terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard la chiede in una finestra e la passa solo a sudo; non la memorizza mai. Se annulli, il foglio mostra il comando per il Terminale."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard는 대화상자에서 암호를 묻고 sudo에만 전달하며, 절대 저장하지 않습니다. 취소하면 시트에 터미널용 명령이 표시됩니다."
          }
        }
      }
    },
    "Tankard can't ask for it here, so the sheet will show the command for Terminal.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard kann hier nicht danach fragen; das Fenster zeigt dann den Befehl fürs Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard ne peut pas le demander ici ; la feuille affichera donc la commande pour Terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard no puede pedirla aquí, así que la hoja mostrará el comando para Terminal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここではパスワードを尋ねられないため、シートにターミナル用のコマンドが表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 无法在这里询问密码，因此表单会显示用于“终端”的命令。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard não pode pedi-la aqui, então a janela mostrará o comando para o Terminal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard non può chiederla qui, quindi il foglio mostrerà il comando per il Terminale."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서는 암호를 물을 수 없으므로 시트에 터미널용 명령이 표시됩니다."
          }
        }
      }
    },
    "Tankard can't ask for it here. Details says what to do instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard kann hier nicht danach fragen. Unter „Details“ steht, was stattdessen zu tun ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard ne peut pas le demander ici. « Détails » indique quoi faire à la place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard no puede pedirla aquí. En Detalles se explica qué hacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankardはここではパスワードを尋ねられません。代わりの方法は「詳細」を参照してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 无法在这里询问密码。请在“详细信息”中查看替代做法。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard não pode pedi-la aqui. Em Detalhes você vê o que fazer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard non può chiederla qui. In Dettagli trovi cosa fare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard는 여기서 암호를 물을 수 없습니다. 대신 할 일은 세부사항을 참고하세요."
          }
        }
      }
    },
    "Tankard checks each app's version against Homebrew's. When they match, Homebrew takes over updates without moving the app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard vergleicht die Version jeder App mit der von Homebrew. Stimmen sie überein, übernimmt Homebrew die Updates, ohne die App zu verschieben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard compare la version de chaque app à celle de Homebrew. Si elles correspondent, Homebrew prend en charge les mises à jour sans déplacer l’app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard compara la versión de cada app con la de Homebrew. Cuando coinciden, Homebrew se encarga de las actualizaciones sin mover la app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard confronta la versione di ogni app con quella di Homebrew. Quando corrispondono, Homebrew si occupa degli aggiornamenti senza spostare l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankardは各アプリのバージョンをHomebrewのものと照合します。一致すれば、アプリを移動せずにHomebrewがアップデートを引き継ぎます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard는 각 앱의 버전을 Homebrew의 버전과 비교합니다. 일치하면 앱을 옮기지 않고 Homebrew가 업데이트를 맡습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 会将每个 App 的版本与 Homebrew 的版本对比。版本一致时，Homebrew 会接管更新，而不移动该 App。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard compara a versão de cada app com a do Homebrew. Quando coincidem, o Homebrew assume as atualizações sem mover o app."
          }
        }
      }
    },
    "Tankard couldn't load Homebrew's list of packages. Try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard konnte die Paketliste von Homebrew nicht laden. Versuche es gleich noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard n’a pas pu charger la liste des paquets de Homebrew. Réessayez dans un instant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard no pudo cargar la lista de paquetes de Homebrew. Inténtalo de nuevo en un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TankardはHomebrewのパッケージ一覧を読み込めませんでした。少し待ってからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 无法加载 Homebrew 的软件包列表。请稍后重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard não conseguiu carregar a lista de pacotes do Homebrew. Tente novamente daqui a pouco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard non è riuscito a caricare l’elenco dei pacchetti di Homebrew. Riprova tra un momento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard가 Homebrew의 패키지 목록을 불러오지 못했습니다. 잠시 후 다시 시도하세요."
          }
        }
      }
    },
    "Tankard couldn't reach the network to download Homebrew's list of packages. Check the internet connection (or a VPN or proxy), then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard konnte das Netzwerk nicht erreichen, um die Paketliste von Homebrew zu laden. Prüfe die Internetverbindung (oder ein VPN oder einen Proxy) und versuche es dann erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard n’a pas pu joindre le réseau pour télécharger la liste des paquets de Homebrew. Vérifiez la connexion Internet (ou un VPN ou un proxy), puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard no pudo acceder a la red para descargar la lista de paquetes de Homebrew. Comprueba la conexión a Internet (o una VPN o un proxy) y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TankardはHomebrewのパッケージ一覧をダウンロードするためにネットワークに接続できませんでした。インターネット接続（またはVPNやプロキシ）を確認してから、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 无法连接网络来下载 Homebrew 的软件包列表。请检查互联网连接（或 VPN、代理），然后重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard não conseguiu acessar a rede para baixar a lista de pacotes do Homebrew. Verifique a conexão com a internet (ou uma VPN ou proxy) e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard non è riuscito a raggiungere la rete per scaricare l’elenco dei pacchetti di Homebrew. Controlla la connessione a Internet (o una VPN o un proxy), poi riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard가 Homebrew의 패키지 목록을 내려받기 위해 네트워크에 연결하지 못했습니다. 인터넷 연결(또는 VPN이나 프록시)을 확인한 다음 다시 시도하세요."
          }
        }
      }
    },
    "Tankard couldn't read the packages in your taps. Try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard konnte die Pakete in deinen Taps nicht lesen. Versuche es gleich noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard n’a pas pu lire les paquets de vos taps. Réessayez dans un instant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard no pudo leer los paquetes de tus taps. Inténtalo de nuevo en un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankardはtap内のパッケージを読み取れませんでした。少し待ってからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 无法读取你的 Tap 中的软件包。请稍后重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard não conseguiu ler os pacotes dos seus taps. Tente novamente daqui a pouco."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard non è riuscito a leggere i pacchetti dei tuoi tap. Riprova tra un momento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard가 tap의 패키지를 읽지 못했습니다. 잠시 후 다시 시도하세요."
          }
        }
      }
    },
    "Tankard couldn't read where this tap comes from in the Brewfile. Use the Terminal command below.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard konnte in der Brewfile nicht lesen, woher dieser Tap kommt. Verwende den Terminalbefehl unten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard n’a pas pu lire dans le Brewfile d’où vient ce tap. Utilisez la commande Terminal ci-dessous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard no pudo leer en el Brewfile de dónde viene este tap. Usa el comando de Terminal de abajo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TankardはBrewfileからこのtapの取得元を読み取れませんでした。下のターミナルコマンドを使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 无法从 Brewfile 中读出此 Tap 的来源。请使用下方的终端命令。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard não conseguiu ler no Brewfile de onde vem este tap. Use o comando do Terminal abaixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard non è riuscito a leggere nel Brewfile da dove viene questo tap. Usa il comando per il Terminale qui sotto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard가 Brewfile에서 이 tap의 출처를 읽지 못했습니다. 아래의 터미널 명령을 사용하세요."
          }
        }
      }
    },
    "Tankard does these one at a time. Each is recorded in History.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard erledigt diese eins nach dem anderen. Jedes wird im Verlauf festgehalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard les traite une à la fois. Chacune est enregistrée dans l’Historique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard los hace uno a uno. Cada uno queda registrado en el Historial."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard li esegue uno alla volta. Ognuno viene registrato nella Cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankardはこれらを1つずつ行います。それぞれ履歴に記録されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard는 이 작업을 하나씩 수행합니다. 각 작업은 기록에 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 会逐个执行这些操作。每一项都会记录在“历史记录”中。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard faz isso um de cada vez. Cada um fica registrado no Histórico."
          }
        }
      }
    },
    "Tankard hasn't read this Mac's Homebrew prefix yet. Refresh first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard hat das Homebrew-Präfix dieses Macs noch nicht gelesen. Aktualisiere zuerst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard n’a pas encore lu le préfixe Homebrew de ce Mac. Actualisez d’abord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard aún no ha leído el prefijo de Homebrew de este Mac. Actualiza primero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankardはこの MacのHomebrewのprefixをまだ読み込んでいません。先に更新してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 尚未读取这台 Mac 的 Homebrew 前缀。请先刷新。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard ainda não leu o prefixo do Homebrew deste Mac. Atualize primeiro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard non ha ancora letto il prefisso Homebrew di questo Mac. Prima aggiorna."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard가 아직 이 Mac의 Homebrew 접두사를 읽지 않았습니다. 먼저 새로 고치세요."
          }
        }
      }
    },
    "Tankard is upgrading %@ automatically (%lld of %lld).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard aktualisiert %@ automatisch (%lld von %lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard met à jour %@ automatiquement (%lld sur %lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard está actualizando %@ automáticamente (%lld de %lld)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard は %@ を自動でアップグレード中です(%lld/%lld)。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 正在自动升级 %@(第 %lld 个,共 %lld 个)。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard está atualizando %@ automaticamente (%lld de %lld)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard sta aggiornando %@ automaticamente (%lld di %lld)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard가 %@을(를) 자동으로 업그레이드하고 있습니다(%lld/%lld)."
          }
        }
      }
    },
    "Tankard is upgrading %@ automatically.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard aktualisiert %@ automatisch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard met à jour %@ automatiquement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard está actualizando %@ automáticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard は %@ を自動でアップグレード中です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 正在自动升级 %@。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard está atualizando %@ automaticamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard sta aggiornando %@ automaticamente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard가 %@을(를) 자동으로 업그레이드하고 있습니다."
          }
        }
      }
    },
    "Tankard itself is never upgraded automatically: use brew upgrade --cask tankard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard selbst wird nie automatisch aktualisiert: nutze brew upgrade --cask tankard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard n’est jamais mis à niveau automatiquement : utilisez brew upgrade --cask tankard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard nunca se actualiza a sí mismo automáticamente: usa brew upgrade --cask tankard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard自体は自動ではアップグレードされません。brew upgrade --cask tankard を使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 本身不会被自动升级：请使用 brew upgrade --cask tankard。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O próprio Tankard nunca é atualizado automaticamente: use brew upgrade --cask tankard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard stesso non viene mai aggiornato automaticamente: usa brew upgrade --cask tankard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 자체는 자동으로 업그레이드되지 않습니다. brew upgrade --cask tankard를 사용하세요."
          }
        }
      }
    },
    "Tankard leaves this app's upgrades out of Upgrade All, the counts and auto-update. Its own updater keeps it current. brew upgrade in Terminal can still upgrade it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard lässt Upgrades dieser App aus „Alle upgraden“, den Zählern und Auto-Update heraus. Ihr eigener Updater hält sie aktuell. brew upgrade im Terminal kann sie weiterhin upgraden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard exclut les mises à niveau de cette app de Tout mettre à niveau, des compteurs et de la mise à jour auto. Son propre outil de mise à jour la garde à jour. brew upgrade dans Terminal peut toujours la mettre à niveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard deja las actualizaciones de esta app fuera de Actualizar todo, los recuentos y la actualización automática. Su propio actualizador la mantiene al día. brew upgrade en Terminal aún puede actualizarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard はこのアプリのアップグレードを「すべてアップグレード」、件数、自動アップデートから除外します。アプリ自身のアップデート機能で最新に保たれます。ターミナルの brew upgrade では引き続きアップグレードできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 会将此 App 的升级排除在“全部升级”、计数和自动更新之外。它自带的更新程序会使其保持最新。在终端中使用 brew upgrade 仍可升级它。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard deixa as atualizações deste app fora de Atualizar tudo, das contagens e da atualização automática. O próprio atualizador do app o mantém em dia. brew upgrade no Terminal ainda pode atualizá-lo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard esclude gli aggiornamenti di questa app da Aggiorna tutto, dai conteggi e dall'aggiornamento automatico. Il suo programma di aggiornamento la mantiene aggiornata. brew upgrade nel Terminal può comunque aggiornarla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard는 이 앱의 업그레이드를 모두 업그레이드, 개수 표시, 자동 업데이트에서 제외합니다. 앱 자체 업데이터가 최신 상태로 유지합니다. 터미널의 brew upgrade로는 여전히 업그레이드할 수 있습니다."
          }
        }
      }
    },
    "Tankard lists every newer version of this cask, upgrades it with Upgrade All and auto-update, and replaces the app the way brew does.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard zeigt jede neuere Version dieses Casks, upgradet es mit „Alle upgraden“ und Auto-Update und ersetzt die App wie brew."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard liste chaque nouvelle version de ce cask, le met à niveau avec Tout mettre à niveau et la mise à jour auto, et remplace l'app comme le fait brew."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard muestra cada versión nueva de este cask, lo actualiza con Actualizar todo y la actualización automática, y reemplaza la app como lo hace brew."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard はこの cask の新しいバージョンをすべて表示し、「すべてアップグレード」と自動アップデートでアップグレードし、brew と同じ方法でアプリを置き換えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 会列出此 cask 的每个新版本，通过“全部升级”和自动更新进行升级，并以 brew 的方式替换 App。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard lista cada versão nova deste cask, o atualiza com Atualizar tudo e a atualização automática, e substitui o app como o brew faz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard elenca ogni nuova versione di questo cask, lo aggiorna con Aggiorna tutto e l'aggiornamento automatico, e sostituisce l'app come fa brew."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard는 이 cask의 모든 새 버전을 표시하고, 모두 업그레이드와 자동 업데이트로 업그레이드하며, brew와 같은 방식으로 앱을 교체합니다."
          }
        }
      }
    },
    "Tankard looks for Homebrew where its installer puts it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard sucht Homebrew dort, wo sein Installationsprogramm es ablegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard cherche Homebrew là où son installeur le place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard busca Homebrew donde lo coloca su instalador."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard cerca Homebrew dove lo mette il suo programma di installazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TankardはHomebrewのインストーラが置く場所でHomebrewを探します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard는 Homebrew 설치 프로그램이 설치하는 위치에서 Homebrew를 찾습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 会在 Homebrew 安装程序放置它的位置查找 Homebrew。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard procura o Homebrew onde o instalador dele o coloca."
          }
        }
      }
    },
    "Tankard needs App Management permission. Allow it in System Settings → Privacy & Security → App Management, relaunch Tankard, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard braucht die App-Verwaltung. Erlaube sie in „Datenschutz & Sicherheit“ → „App-Verwaltung“, starte Tankard neu und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard a besoin de l’autorisation Gestion des apps. Autorisez-la dans Réglages Système → Confidentialité et sécurité → Gestion des apps, relancez Tankard, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard necesita el permiso Gestión de apps. Permítelo en Ajustes del Sistema → Privacidad y seguridad → Gestión de apps, reinicia Tankard y vuelve a intentarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TankardにはApp管理の許可が必要です。「システム設定」→「プライバシーとセキュリティ」→「App管理」で許可し、Tankardを再起動してからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 需要“App 管理”权限。请在“系统设置”→“隐私与安全性”→“App 管理”中允许，重新启动 Tankard，然后重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard precisa da permissão Gerenciamento de Apps. Permita em Ajustes do Sistema → Privacidade e Segurança → Gerenciamento de Apps, reabra o Tankard e tente de novo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard ha bisogno del permesso Gestione app. Consentilo in Impostazioni di Sistema → Privacy e sicurezza → Gestione app, riavvia Tankard e riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard에 앱 관리 권한이 필요합니다. 시스템 설정 → 개인정보 보호 및 보안 → 앱 관리에서 허용하고 Tankard를 다시 시작한 다음 다시 시도하세요."
          }
        }
      }
    },
