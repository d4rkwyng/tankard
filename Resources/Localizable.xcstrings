        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择服务"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um serviço"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un servizio"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서비스 선택"
          }
        }
      }
    },
    "Self-updating apps are included only when \"Include self-updating apps\" is on, or when you chose \"Homebrew updates it\" for that app; never when you chose \"App updates itself\".": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbstaktualisierende Apps sind nur dabei, wenn „Selbstaktualisierende Apps einbeziehen“ an ist oder für die App „Homebrew“ gewählt wurde; nie bei „App selbst“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps qui se mettent à jour seules ne sont incluses que si « Inclure les apps à mise à jour automatique » est activé, ou si vous avez choisi « Homebrew » pour cette app ; jamais si vous avez choisi « L'app elle-même »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps que se actualizan solas solo se incluyen si «Incluir apps que se actualizan solas» está activado, o si elegiste «Homebrew» para esa app; nunca si elegiste «La propia app»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自己更新するアプリが含まれるのは、「自己更新するアプリを含める」がオンのとき、またはそのアプリで「Homebrew が更新」を選んだときだけです。「アプリが更新」を選んだ場合は含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有开启“包含自行更新的 App”，或为该 App 选择了“由 Homebrew 更新”时，才会包含自行更新的 App；选择“App 自行更新”时则永不包含。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que se atualizam sozinhos só entram quando \"Incluir apps que se atualizam sozinhos\" está ativado, ou quando você escolheu \"Homebrew\" para aquele app; nunca quando escolheu \"O próprio app\"."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app che si aggiornano da sole sono incluse solo se \"Includi app che si aggiornano da sole\" è attivo, o se per quell'app hai scelto \"Homebrew\"; mai se hai scelto \"L'app stessa\"."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 업데이트 앱은 \"자체 업데이트 앱 포함\"이 켜져 있거나 해당 앱에 \"Homebrew가 업데이트\"를 선택한 경우에만 포함됩니다. \"앱이 직접 업데이트\"를 선택한 경우에는 포함되지 않습니다."
          }
        }
      }
    },
    "Self-updating apps not checked: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sich selbst aktualisierende Apps nicht geprüft: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps à mise à jour automatique non vérifiées : %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps con actualización propia no comprobadas: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自己アップデートするアプリは確認されていません: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检查可自行更新的 App：%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps com atualização própria não verificados: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App che si aggiornano da sole non controllate: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자체 업데이트 앱을 확인하지 않음: %@"
          }
        }
      }
    },
    "Sends your installed formula names and versions to OSV.dev (via brew vulns).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet die Namen und Versionen deiner installierten Formulae an OSV.dev (über brew vulns)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie les noms et versions de vos formulae installées à OSV.dev (via brew vulns)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía los nombres y versiones de tus formulae instaladas a OSV.dev (mediante brew vulns)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みformulaの名前とバージョンをOSV.dev（brew vulns経由）に送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你已安装的 formula 名称和版本发送到 OSV.dev（通过 brew vulns）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia os nomes e versões das suas formulae instaladas ao OSV.dev (via brew vulns)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia i nomi e le versioni delle formula installate a OSV.dev (tramite brew vulns)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 formula 이름과 버전을 OSV.dev로 보냅니다(brew vulns 사용)."
          }
        }
      }
    },
