    "Only available in Tankard.app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur in Tankard.app verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible uniquement dans Tankard.app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo disponible en Tankard.app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard.appでのみ利用できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在 Tankard.app 中可用。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponível apenas no Tankard.app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibile solo in Tankard.app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard.app에서만 사용할 수 있습니다."
          }
        }
      }
    },
    "Only if you really need this version. It downloads Homebrew's full package history, and you look after the old version yourself from then on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur, wenn du diese Version wirklich brauchst. Dabei wird der vollständige Paketverlauf von Homebrew geladen, und um die alte Version kümmerst du dich ab dann selbst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement si vous avez vraiment besoin de cette version. Cela télécharge l’historique complet des paquets de Homebrew, et vous gérez ensuite vous-même l’ancienne version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo si de verdad necesitas esta versión. Descarga el historial completo de paquetes de Homebrew y, a partir de entonces, la versión anterior queda a tu cargo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se ti serve davvero questa versione. Scarica l'intera cronologia dei pacchetti di Homebrew e da quel momento la vecchia versione è a tuo carico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンがどうしても必要な場合のみ。Homebrewのパッケージ履歴をすべてダウンロードし、以後は古いバージョンを自分で管理することになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전이 꼭 필요할 때만 사용하세요. Homebrew의 전체 패키지 기록을 다운로드하며, 이후 이전 버전은 직접 관리해야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在你确实需要这个版本时使用。它会下载 Homebrew 的完整软件包历史，此后旧版本需要你自行维护。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só se você realmente precisar desta versão. Isso baixa todo o histórico de pacotes do Homebrew, e a partir daí você mesmo cuida da versão antiga."
          }
        }
      }
    },
    "Only the name matches, so this may be a different app rather than an older version of it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Name stimmt, daher kann es eine andere App sein statt einer älteren Version davon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le nom correspond : ce peut être une autre app plutôt qu’une version plus ancienne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo coincide el nombre, así que puede ser otra app y no una versión anterior."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前だけが一致しているため、古いバージョンではなく別のアプリかもしれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有名称一致,因此这可能是另一个应用,而不是它的旧版本。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o nome confere, então pode ser outro app, e não uma versão mais antiga dele."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrisponde solo il nome, quindi potrebbe essere un’altra app e non una sua versione precedente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름만 같으므로 이전 버전이 아니라 다른 앱일 수 있습니다."
          }
        }
      }
    },
    "Only what %@ needed. Dependencies that were already unused stay installed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur was %@ brauchte. Bereits ungenutzte Abhängigkeiten bleiben installiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement ce dont %@ avait besoin. Les dépendances déjà inutilisées restent installées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lo que necesitaba %@. Las dependencias que ya no se usaban siguen instaladas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が必要としていたものだけです。すでに使われていなかった依存関係はインストールされたままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限 %@ 所需的项。原本就未使用的依赖项仍保持安装。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o que %@ usava. Dependências que já não eram usadas continuam instaladas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo ciò che serviva a %@. Le dipendenze già inutilizzate restano installate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 필요했던 것만 해당됩니다. 이미 사용되지 않던 의존성은 그대로 설치되어 있습니다."
          }
        }
      }
    },
