    "Self-updating apps are included only when \"Include self-updating apps\" is on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sich selbst aktualisierende Apps werden nur einbezogen, wenn „Sich selbst aktualisierende Apps einbeziehen“ an ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps à mise à jour automatique ne sont incluses que si « Inclure les apps à mise à jour automatique » est activé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps con actualización propia solo se incluyen si \"Incluir apps con actualización propia\" está activado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自己アップデートするアプリは、「自己アップデートするアプリを含める」がオンの場合にのみ含まれます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当“包含可自行更新的 App”开启时，才包含可自行更新的 App。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps com atualização própria só são incluídos quando \"Incluir apps com atualização própria\" está ativado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le app che si aggiornano da sole sono incluse solo se \"Includi le app che si aggiornano da sole\" è attivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"자체 업데이트 앱 포함\"이 켜져 있을 때만 자체 업데이트 앱이 포함됩니다."
          }
        }
      }
    },
