          }
        }
      }
    },
    "Some installed tools put commands in sbin; your shell won't find them by name until it's in PATH.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige installierte Tools legen Befehle in sbin ab; deine Shell findet sie nicht per Namen, solange sbin nicht im PATH ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains outils installés placent leurs commandes dans sbin ; votre shell ne les trouvera pas par leur nom tant qu’il n’est pas dans le PATH."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas herramientas instaladas ponen comandos en sbin; tu shell no los encontrará por nombre hasta que esté en el PATH."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みの一部のツールはコマンドをsbinに置きます。PATHに含まれるまで、シェルは名前でそれらを見つけられません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分已安装的工具会把命令放在 sbin 中；在其加入 PATH 之前，你的 shell 无法按名称找到它们。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas ferramentas instaladas colocam comandos em sbin; seu shell não os encontra pelo nome até que esteja no PATH."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni strumenti installati mettono i comandi in sbin; la tua shell non li troverà per nome finché non è nel PATH."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 일부 도구는 명령을 sbin에 둡니다. PATH에 추가하기 전에는 셸이 이름으로 찾지 못합니다."
          }
        }
      }
    },
