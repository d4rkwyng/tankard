    "One at a time through Tankard's queue. Each is recorded in History.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nacheinander über die Warteschlange von Tankard. Jeder Schritt wird im Verlauf festgehalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un par un, via la file d’attente de Tankard. Chacun est consigné dans l’historique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una a una mediante la cola de Tankard. Cada una queda registrada en el Historial."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankardのキューで1つずつ実行されます。それぞれ履歴に記録されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Tankard 的队列逐个执行。每项都会记录在“历史记录”中。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um de cada vez pela fila do Tankard. Cada um é registrado no Histórico."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno alla volta tramite la coda di Tankard. Ognuno viene registrato nella Cronologia."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard의 대기열을 통해 하나씩 실행합니다. 각각 기록에 남습니다."
          }
        }
      }
    },
    "One brew install per formula and cask, through Tankard's queue and log. Add taps first with Add Tap….": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein brew install pro Formula und Cask, über Warteschlange und Protokoll von Tankard. Füge zuerst Taps mit „Tap hinzufügen…“ hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un brew install par formula et cask, via la file d’attente et le journal de Tankard. Ajoutez d’abord les taps avec Ajouter un tap…."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un brew install por formula y cask, mediante la cola y el registro de Tankard. Añade antes los taps con Añadir tap…."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "formulaとcaskごとに1回のbrew installを、Tankardのキューとログ経由で実行します。先に「Tapを追加…」でtapを追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个 formula 和 cask 各执行一次 brew install，通过 Tankard 的队列和日志进行。请先用“添加 Tap…”添加 tap。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um brew install por formula e cask, pela fila e pelo log do Tankard. Adicione os taps antes com Adicionar Tap…."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un brew install per ogni formula e cask, tramite la coda e il registro di Tankard. Aggiungi prima i tap con Aggiungi tap…."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "formula와 cask마다 brew install을 한 번씩 Tankard의 대기열과 로그를 통해 실행합니다. 먼저 tap 추가…로 tap을 추가하세요."
          }
        }
      }
    },
