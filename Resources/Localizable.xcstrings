    "Adopting runs through Tankard's queue and History.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übernahme läuft über die Warteschlange und den Verlauf von Tankard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adoption passe par la file d'attente et l'Historique de Tankard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La adopción pasa por la cola y el Historial de Tankard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き継ぎは Tankard のキューと履歴を通じて実行されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接管通过 Tankard 的队列和历史记录进行。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A adoção passa pela fila e pelo Histórico do Tankard."
          }
        },
