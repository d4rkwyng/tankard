    "%lld %@ no bottle for this Mac and will compile from source, which can take a long time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %@ keine Bottle für diesen Mac und werden aus Quellcode kompiliert, was lange dauern kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %@ sans bottle pour ce Mac et seront compilés depuis les sources, ce qui peut prendre beaucoup de temps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %@ sin bottle para este Mac y se compilarán desde el código fuente, lo que puede tardar mucho."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %@ はこのMac用のbottleがなく、ソースからコンパイルされます。時間がかかる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %@ 没有适用于这台 Mac 的 bottle，将从源码编译，这可能需要很长时间。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld %@ sem bottle para este Mac e serão compilados do código-fonte, o que pode demorar muito."
