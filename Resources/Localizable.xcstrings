          }
        }
      }
    },
    "Tankard quit after %lld of %lld. Still to upgrade: %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard wurde nach %lld von %lld beendet. Noch zu aktualisieren: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard a quitté après %lld sur %lld. Reste à mettre à jour : %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard se cerró tras %lld de %lld. Falta actualizar: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard は %lld/%lld の時点で終了しました。残りのアップグレード: %@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 在第 %lld 个(共 %lld 个)后退出。仍需升级:%@。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
