        }
      }
    },
    "The Homebrew folders aren't writable by this user. `brew doctor` (Homebrew ▸ Health) usually says which, and the command to fix it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Homebrew-Ordner sind für diesen Benutzer nicht beschreibbar. `brew doctor` (Homebrew ▸ Zustand) nennt meist, welche, und den Befehl zur Behebung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers de Homebrew ne sont pas accessibles en écriture pour cet utilisateur. `brew doctor` (Homebrew ▸ Santé) indique généralement lesquels, ainsi que la commande de correction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas de Homebrew no tienen permiso de escritura para este usuario. `brew doctor` (Homebrew ▸ Salud) suele indicar cuáles y el comando para corregirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このユーザーはHomebrewのフォルダに書き込めません。通常は `brew doctor`（Homebrew ▸ ヘルス）で原因と修正コマンドが分かります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此用户无法写入 Homebrew 文件夹。`brew doctor`（Homebrew ▸ 健康状况）通常会指出是哪些，以及修复命令。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As pastas do Homebrew não são graváveis por este usuário. O `brew doctor` (Homebrew ▸ Saúde) geralmente diz quais são e o comando para corrigir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cartelle di Homebrew non sono scrivibili da questo utente. `brew doctor` (Homebrew ▸ Salute) di solito indica quali, e il comando per risolvere."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사용자는 Homebrew 폴더에 쓸 수 없습니다. 보통 `brew doctor`(Homebrew ▸ 상태)가 어느 폴더인지와 해결 명령을 알려 줍니다."
          }
        }
      }
    },
    "The Installed list, filtered to this tap (tap:%@)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Liste „Installiert“, gefiltert auf diesen Tap (tap:%@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste des installés, filtrée sur ce tap (tap:%@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de Instalados, filtrada por este tap (tap:%@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このtapで絞り込んだインストール済みリスト (tap:%@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“已安装”列表，已按此 tap 过滤 (tap:%@)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de Instalados, filtrada por este tap (tap:%@)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco Installati, filtrato per questo tap (tap:%@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 tap으로 필터링한 설치됨 목록 (tap:%@)"
          }
        }
      }
    },
    "The URL must be https://, http://, ssh://, git:// or file://, or git@host:path, with no spaces.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die URL muss https://, http://, ssh://, git:// oder file:// bzw. git@host:pfad sein, ohne Leerzeichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’URL doit être https://, http://, ssh://, git:// ou file://, ou git@hôte:chemin, sans espaces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL debe ser https://, http://, ssh://, git:// o file://, o git@host:ruta, sin espacios."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "URLは https://、http://、ssh://、git:// または file://、もしくは git@host:path 形式で、スペースを含められません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "URL 必须是 https://、http://、ssh://、git:// 或 file://，或 git@host:path，且不含空格。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A URL deve ser https://, http://, ssh://, git:// ou file://, ou git@host:path, sem espaços."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'URL deve essere https://, http://, ssh://, git:// o file://, oppure git@host:path, senza spazi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "URL은 https://, http://, ssh://, git:// 또는 file://, 혹은 git@host:path 형식이어야 하며 공백이 없어야 합니다."
          }
        }
      }
    },
    "The app has no version brew can compare.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App hat keine Version, die brew vergleichen kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app n'a pas de version que brew peut comparer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no tiene una versión que brew pueda comparar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリには brew が比較できるバージョンがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该 App 没有 brew 可比较的版本。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app não tem uma versão que o brew possa comparar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'app non ha una versione che brew possa confrontare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱에는 brew가 비교할 수 있는 버전이 없습니다."
          }
        }
      }
    },
    "The app's ID (its bundle identifier) is one the cask names.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ID der App (ihr Bundle-Identifier) ist eine, die der Cask nennt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ID de l’app (son identifiant de bundle) est l’un de ceux que le cask nomme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ID de la app (su identificador de paquete) es uno de los que nombra el cask."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのID(バンドル識別子)が cask に記載されたものと同じです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用的 ID(其 Bundle 标识符)是 cask 列出的 ID 之一。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ID do app (seu identificador de pacote) é um dos que o cask cita."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ID dell’app (il suo identificatore di bundle) è uno di quelli indicati dal cask."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱의 ID(번들 식별자)가 cask에 적힌 ID와 같습니다."
          }
        }
      }
    },
    "The cask always downloads the newest version, so brew compares after downloading; if they differ, it leaves the app alone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Cask lädt immer die neueste Version, also vergleicht brew nach dem Download; bei Abweichung bleibt die App unangetastet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cask télécharge toujours la version la plus récente, donc brew compare après le téléchargement ; en cas de différence, il ne touche pas à l'app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cask siempre descarga la versión más reciente, así que brew compara después de descargar; si difieren, no toca la app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この cask は常に最新バージョンをダウンロードするため、brew はダウンロード後に比較します。違いがあればアプリには手を付けません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 cask 总是下载最新版本，因此 brew 会在下载后比较；如果不同，就不会改动该 App。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cask sempre baixa a versão mais recente, então o brew compara depois de baixar; se forem diferentes, ele não mexe no app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cask scarica sempre la versione più recente, quindi brew confronta dopo il download; se sono diverse, non tocca l'app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 cask는 항상 최신 버전을 다운로드하므로 brew는 다운로드 후 비교합니다. 다르면 앱을 건드리지 않습니다."
          }
        }
      }
    },
    "The cask installs to %@; brew adopts only an app at that exact place.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Cask installiert nach %@; brew übernimmt nur eine App genau an diesem Ort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cask installe dans %@ ; brew n'adopte qu'une app située exactement à cet endroit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cask instala en %@; brew solo adopta una app en esa ubicación exacta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この cask は %@ にインストールします。brew はその場所にあるアプリだけを引き継ぎます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 cask 安装到 %@；brew 只接管正好位于该位置的 App。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cask instala em %@; o brew só adota um app exatamente nesse local."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cask installa in %@; brew adotta solo un'app che si trova esattamente lì."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 cask는 %@에 설치합니다. brew는 정확히 그 위치에 있는 앱만 가져옵니다."
          }
        }
      }
    },
    "The cask names an app ID from the same developer, but not this app's exact ID: check before adopting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Cask nennt eine App-ID desselben Entwicklers, aber nicht genau die ID dieser App: vor dem Übernehmen prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cask nomme un ID d’app du même développeur, mais pas l’ID exact de cette app : vérifiez avant d’adopter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cask nombra un ID de app del mismo desarrollador, pero no el ID exacto de esta app: compruébalo antes de adoptar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cask には同じ開発元のアプリIDがありますが、このアプリのIDそのものではありません。引き継ぐ前に確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cask 列出了同一开发者的应用 ID,但不是此应用的确切 ID:接管前请核对。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cask cita um ID de app do mesmo desenvolvedor, mas não o ID exato deste app: confira antes de adotar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cask indica un ID app dello stesso sviluppatore, ma non l’ID esatto di questa app: controlla prima di adottare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cask에 같은 개발자의 앱 ID가 있지만 이 앱의 ID와 정확히 같지는 않습니다. 가져오기 전에 확인하세요."
          }
        }
      }
    },
    "The cask names no app ID, so only the app's name could be compared. It may be a different app with the same name: check before adopting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Cask nennt keine App-ID, daher konnte nur der Name der App verglichen werden. Es kann eine andere App mit demselben Namen sein: vor dem Übernehmen prüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cask ne nomme aucun ID d’app : seul le nom de l’app a pu être comparé. Ce peut être une autre app du même nom : vérifiez avant d’adopter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cask no nombra ningún ID de app, así que solo se pudo comparar el nombre. Puede ser otra app con el mismo nombre: compruébalo antes de adoptar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cask にアプリIDの記載がないため、アプリの名前しか比べられませんでした。同じ名前の別のアプリかもしれません。引き継ぐ前に確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cask 未列出应用 ID,因此只能比较应用名称。它可能是同名的另一个应用:接管前请核对。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cask não cita nenhum ID de app, então só o nome do app pôde ser comparado. Pode ser outro app com o mesmo nome: confira antes de adotar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cask non indica alcun ID app, quindi si è potuto confrontare solo il nome. Potrebbe essere un’altra app con lo stesso nome: controlla prima di adottare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cask에 앱 ID가 없어 앱 이름만 비교할 수 있었습니다. 이름이 같은 다른 앱일 수 있으니 가져오기 전에 확인하세요."
          }
        }
      }
    },
    "The cask names no app ID. The app's name matches, and its ID names the developer of the cask's website.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Cask nennt keine App-ID. Der Name der App stimmt, und ihre ID nennt den Entwickler der Website des Casks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cask ne nomme aucun ID d’app. Le nom de l’app correspond, et son ID nomme le développeur du site web du cask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cask no nombra ningún ID de app. El nombre de la app coincide y su ID nombra al desarrollador del sitio web del cask."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cask にアプリIDの記載はありません。アプリの名前が一致し、そのIDが cask のWebサイトの開発元を示しています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "cask 未列出应用 ID。应用名称一致,且其 ID 指向 cask 网站的开发者。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cask não cita nenhum ID de app. O nome do app confere, e o ID dele cita o desenvolvedor do site do cask."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cask non indica alcun ID app. Il nome dell’app corrisponde e il suo ID indica lo sviluppatore del sito web del cask."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cask에 앱 ID가 없습니다. 앱 이름이 같고, 앱 ID가 cask 웹사이트의 개발자를 가리킵니다."
          }
        }
      }
    },
    "The cask says this app updates itself (auto_updates).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laut Cask aktualisiert sich diese App selbst (auto_updates)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cask indique que cette app se met à jour seule (auto_updates)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El cask indica que esta app se actualiza sola (auto_updates)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "cask によると、このアプリは自己更新します（auto_updates）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 cask 声明该 App 会自行更新（auto_updates）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cask diz que este app se atualiza sozinho (auto_updates)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il cask indica che questa app si aggiorna da sola (auto_updates)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "cask에 따르면 이 앱은 자체 업데이트합니다(auto_updates)."
          }
        }
      }
    },
    "The disk is full": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Datenträger ist voll"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le disque est plein"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El disco está lleno"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスクがいっぱいです"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘已满"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco está cheio"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il disco è pieno"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스크가 가득 찼습니다"
          }
        }
      }
    },
    "The file brew downloaded isn't the one it expected: often an interrupted download, or a package that changed since brew last updated. Refresh (it runs brew update), then retry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die geladene Datei ist nicht die erwartete: oft ein abgebrochener Download oder ein Paket, das sich seit dem letzten brew update geändert hat. Aktualisieren (führt brew update aus), dann erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier téléchargé par brew n'est pas celui attendu : souvent un téléchargement interrompu, ou un paquet modifié depuis le dernier brew update. Actualisez (cela lance brew update), puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo que descargó brew no es el esperado: a menudo una descarga interrumpida o un paquete que cambió desde el último brew update. Actualiza la lista (ejecuta brew update) y reintenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brew がダウンロードしたファイルが想定と異なります。ダウンロードの中断や、前回の brew update 以降のパッケージ変更が主な原因です。再読み込み(brew update を実行)してから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "brew 下载的文件不是预期的文件:通常是下载中断,或软件包在上次 brew update 后有变化。请刷新(会运行 brew update),然后重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo baixado pelo brew não é o esperado: muitas vezes um download interrompido, ou um pacote que mudou desde o último brew update. Atualize a lista (executa brew update) e tente de novo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file scaricato da brew non è quello atteso: spesso un download interrotto, o un pacchetto cambiato dall'ultimo brew update. Aggiorna l'elenco (esegue brew update), poi riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "brew가 받은 파일이 예상한 파일이 아닙니다. 대개 중단된 다운로드이거나 마지막 brew update 이후 바뀐 패키지입니다. 새로 고침(brew update 실행)한 뒤 다시 시도하세요."
          }
        }
      }
    },
    "The installer asks for your password and runs in Terminal. When it finishes, come back and click Check Again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Installationsprogramm fragt nach deinem Passwort und läuft im Terminal. Komm danach zurück und klicke auf „Erneut prüfen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme d’installation demande votre mot de passe et s’exécute dans Terminal. Une fois terminé, revenez et cliquez sur Vérifier à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El instalador pide tu contraseña y se ejecuta en Terminal. Cuando termine, vuelve y haz clic en Comprobar de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストーラがパスワードを求め、ターミナルで実行されます。完了したら戻って「もう一度確認」をクリックしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装程序会要求输入密码并在“终端”中运行。完成后，请回来点按“再次检查”。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O instalador pede sua senha e roda no Terminal. Quando terminar, volte e clique em Verificar novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il programma di installazione chiede la tua password e viene eseguito nel Terminale. Al termine, torna qui e clicca su Controlla di nuovo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치 프로그램이 암호를 요청하며 터미널에서 실행됩니다. 끝나면 돌아와서 다시 확인을 클릭하세요."
          }
        }
      }
    },
    "The last %lld are kept in Application Support.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten %lld werden in Application Support behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld dernières sont conservées dans Application Support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan los últimos %lld en Application Support."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近%lld件がApplication Supportに保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 %lld 个保存在 Application Support 中。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os últimos %lld são mantidos em Application Support."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli ultimi %lld sono conservati in Application Support."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 %lld개는 Application Support에 보관됩니다."
          }
        }
      }
    },
    "The last %lld automatic runs. brew's full output is in %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten %lld automatischen Läufe. Die vollständige Ausgabe von brew liegt in %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld dernières exécutions automatiques. La sortie complète de brew se trouve dans %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las últimas %lld ejecuciones automáticas. La salida completa de brew está en %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近%lld回の自動実行。brewの完全な出力は%@にあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 %lld 次自动运行。brew 的完整输出位于 %@。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As últimas %lld execuções automáticas. A saída completa do brew está em %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ultime %lld esecuzioni automatiche. L'output completo di brew è in %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 자동 실행 %lld건. brew의 전체 출력은 %@에 있습니다."
          }
        }
      }
    },
    "The last scan (%@) found none.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der letzte Scan (%@) hat keine gefunden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
