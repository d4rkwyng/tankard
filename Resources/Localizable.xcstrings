          }
        }
      }
    },
    "Shows a tankard icon with the number of upgrades ready. While it's on, closing the window keeps Tankard running.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt einen Humpen mit der Anzahl bereiter Upgrades. Solange aktiv, läuft Tankard nach dem Schließen des Fensters weiter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche une chope avec le nombre de mises à niveau prêtes. Tant qu’elle est affichée, fermer la fenêtre laisse Tankard ouvert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra una jarra con el número de actualizaciones listas. Mientras está activado, al cerrar la ventana Tankard sigue abierto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップグレード可能な数をTankardアイコンで表示します。オンの間は、ウインドウを閉じてもTankardは実行され続けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示带有待升级数量的 tankard 图标。开启时，关闭窗口后 Tankard 仍会继续运行。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra uma caneca com o número de atualizações prontas. Enquanto ativado, fechar a janela mantém o Tankard aberto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra un tankard con il numero di aggiornamenti pronti. Finché è attivo, chiudere la finestra lascia Tankard in esecuzione."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업그레이드 준비된 개수를 tankard 아이콘으로 보여줍니다. 켜져 있는 동안에는 윈도우를 닫아도 Tankard가 계속 실행됩니다."
          }
        }
      }
    },
    "Shows what will change first": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt zuerst, was sich ändert"
