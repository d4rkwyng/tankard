          }
        }
      }
    },
    "Quitting now stops it: Homebrew undoes the unfinished step, and the rest won't run.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden stoppt es: Homebrew macht den offenen Schritt rückgängig, der Rest läuft nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter l'arrête : Homebrew annule l'étape en cours, et le reste ne sera pas exécuté."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir lo detiene: Homebrew deshace el paso sin terminar y el resto no se ejecutará."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了すると停止します。Homebrew は途中の手順を元に戻し、残りは実行されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出会停止它:Homebrew 撤销未完成的步骤,其余的不会运行。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerrar interrompe: o Homebrew desfaz a etapa inacabada e o restante não será executado."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscire lo interrompe: Homebrew annulla il passaggio in corso e il resto non verrà eseguito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료하면 중지됩니다. Homebrew가 끝나지 않은 단계를 되돌리고 나머지는 실행되지 않습니다."
          }
        }
      }
    },
    "Quitting now stops it: Homebrew undoes the unfinished step, and the rest won't run. Tankard offers to upgrade what's left next time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden stoppt es: Homebrew macht den offenen Schritt rückgängig, der Rest läuft nicht. Tankard bietet den Rest beim nächsten Start an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter l'arrête : Homebrew annule l'étape en cours, et le reste ne sera pas exécuté. Tankard proposera de mettre à jour le reste la prochaine fois."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salir lo detiene: Homebrew deshace el paso sin terminar y el resto no se ejecutará. Tankard ofrecerá actualizar lo que falte la próxima vez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了すると停止します。Homebrew は途中の手順を元に戻し、残りは実行されません。次回、残りのアップグレードを提案します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出会停止它:Homebrew 撤销未完成的步骤,其余的不会运行。下次 Tankard 会提议升级剩下的。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerrar interrompe: o Homebrew desfaz a etapa inacabada e o restante não será executado. O Tankard oferece atualizar o que faltou na próxima vez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscire lo interrompe: Homebrew annulla il passaggio in corso e il resto non verrà eseguito. Tankard proporrà di aggiornare il resto la prossima volta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료하면 중지됩니다. Homebrew가 끝나지 않은 단계를 되돌리고 나머지는 실행되지 않습니다. 다음에 Tankard가 남은 업그레이드를 제안합니다."
          }
        }
      }
    },
