    },
    "Homebrew doesn't list Tankard %@ yet: the tap can take a little while after a release. Try again later, or download it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew führt Tankard %@ noch nicht: Der Tap braucht nach einem Release etwas Zeit. Versuche es später erneut oder lade es herunter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ne liste pas encore Tankard %@ : le tap peut mettre un peu de temps après une version. Réessayez plus tard, ou téléchargez-le."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew aún no muestra Tankard %@: el tap puede tardar un poco tras una versión. Inténtalo más tarde o descárgalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HomebrewにはまだTankard %@ がありません。リリース後、tapへの反映には少し時間がかかることがあります。後でもう一度試すか、ダウンロードしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 尚未列出 Tankard %@：发布后 tap 可能需要一点时间更新。请稍后重试，或直接下载。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew ainda não lista o Tankard %@: o tap pode levar um tempo após uma versão. Tente mais tarde ou baixe-o."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew non elenca ancora Tankard %@: il tap può richiedere un po’ di tempo dopo una versione. Riprova più tardi o scaricalo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew에 아직 Tankard %@이(가) 없습니다. 릴리스 후 tap에 반영되기까지 시간이 걸릴 수 있습니다. 나중에 다시 시도하거나 다운로드하세요."
          }
        }
      }
    },
    "Homebrew doesn't uninstall pinned packages. Unpin %@ first, or keep it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew deinstalliert keine fixierten Pakete. Löse %@ zuerst oder behalte es."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ne désinstalle pas les paquets épinglés. Désépinglez %@ d'abord, ou gardez-le."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew no desinstala paquetes fijados. Desfija %@ primero o consérvalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew はピン留めされたパッケージをアンインストールしません。先に %@ のピン留めを解除するか、そのままにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 不会卸载已固定的软件包。请先取消固定 %@，或保留它。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew não desinstala pacotes fixados. Desafixe %@ primeiro ou mantenha-o."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew non disinstalla i pacchetti bloccati. Sblocca prima %@ o tienilo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew는 고정된 패키지를 제거하지 않습니다. 먼저 %@의 고정을 해제하거나 그대로 두십시오."
          }
        }
      }
    },
    "Homebrew has a cask for these apps and the installed version matches (or the app updates itself, so brew doesn't compare).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew hat ein Cask für diese Apps und die installierte Version passt (oder die App aktualisiert sich selbst, dann vergleicht brew nicht)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew a un cask pour ces apps et la version installée correspond (ou l'app se met à jour seule, donc brew ne compare pas)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew tiene un cask para estas apps y la versión instalada coincide (o la app se actualiza sola, así que brew no compara)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアプリには Homebrew の cask があり、インストール済みのバージョンが一致しています（またはアプリが自己更新するため brew は比較しません）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 有这些 App 的 cask，且已安装的版本一致（或 App 会自行更新，因此 brew 不做比较）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew tem um cask para esses apps e a versão instalada confere (ou o app se atualiza sozinho, então o brew não compara)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ha un cask per queste app e la versione installata corrisponde (oppure l'app si aggiorna da sola, quindi brew non confronta)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew에 이 앱들의 cask가 있고 설치된 버전이 일치합니다(또는 앱이 자체 업데이트하므로 brew가 비교하지 않습니다)."
          }
        }
      }
    },
    "Homebrew has disabled this cask.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew hat dieses Cask deaktiviert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew a désactivé ce cask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ha desactivado este cask."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew はこの cask を無効にしています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 已停用此 cask。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew desativou este cask."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ha disattivato questo cask."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew가 이 cask를 비활성화했습니다."
          }
        }
      }
    },
    "Homebrew installed this copy, so Homebrew upgrades it, through the queue. Tankard keeps running while brew replaces the app, then offers to relaunch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew hat diese Kopie installiert, also aktualisiert Homebrew sie über die Warteschlange. Tankard läuft weiter, während brew die App ersetzt, und bietet dann einen Neustart an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew a installé cette copie, c’est donc Homebrew qui la met à jour, via la file d’attente. Tankard continue de tourner pendant que brew remplace l’app, puis propose de la relancer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew instaló esta copia, así que Homebrew la actualiza, a través de la cola. Tankard sigue en marcha mientras brew reemplaza la app y luego ofrece reiniciarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコピーはHomebrewでインストールされたため、Homebrewがキューを通じてアップグレードします。brewがアプリを置き換える間もTankardは動作し続け、完了後に再起動を提案します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此副本由 Homebrew 安装，因此由 Homebrew 通过队列升级。brew 替换应用时 Tankard 会继续运行，完成后提示重新启动。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew instalou esta cópia, então o Homebrew a atualiza, pela fila. O Tankard continua aberto enquanto o brew substitui o app e depois oferece reabri-lo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa copia è stata installata da Homebrew, quindi è Homebrew ad aggiornarla, tramite la coda. Tankard resta aperto mentre brew sostituisce l’app, poi propone di riavviarla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사본은 Homebrew로 설치되었으므로 Homebrew가 대기열을 통해 업그레이드합니다. brew가 앱을 교체하는 동안 Tankard는 계속 실행되며, 완료 후 다시 시작할지 묻습니다."
          }
        }
      }
    },
    "Homebrew is changing %@ now. If you stop, Homebrew undoes the unfinished step and %@ stays as it was. If anything is left half done, running it again usually fixes it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ändert gerade %1$@. Beim Stoppen macht Homebrew den offenen Schritt rückgängig, %2$@ bleibt wie es war. Bleibt etwas halb fertig, hilft meist ein erneuter Lauf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew modifie %1$@ en ce moment. Si vous arrêtez, Homebrew annule l'étape en cours et %2$@ reste tel quel. S'il reste quelque chose à moitié fait, relancer corrige généralement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew está cambiando %1$@ ahora. Si lo detienes, Homebrew deshace el paso sin terminar y %2$@ queda como estaba. Si algo queda a medias, volver a ejecutarlo suele arreglarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew は今 %1$@ を変更しています。停止すると、Homebrew は途中の手順を元に戻し、%2$@ は元のままです。中途半端に残った場合も、もう一度実行すれば通常は直ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 正在更改 %1$@。如果停止,Homebrew 会撤销未完成的步骤,%2$@ 保持原样。如有残留,重新运行通常即可修复。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew está alterando %1$@ agora. Se você parar, o Homebrew desfaz a etapa inacabada e %2$@ fica como estava. Se algo ficar pela metade, executar de novo costuma resolver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew sta modificando %1$@ ora. Se interrompi, Homebrew annulla il passaggio in corso e %2$@ resta com'era. Se resta qualcosa a metà, rieseguire di solito risolve."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew가 지금 %1$@을(를) 변경하고 있습니다. 중지하면 Homebrew가 끝나지 않은 단계를 되돌리고 %2$@은(는) 그대로 유지됩니다. 어중간하게 남은 것이 있으면 다시 실행하면 대개 해결됩니다."
          }
        }
      }
    },
    "Homebrew is still upgrading %@ (%lld of %lld).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew aktualisiert noch %@ (%lld von %lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew met encore à jour %@ (%lld sur %lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew aún está actualizando %@ (%lld de %lld)."
          }
        },
        "ja": {
