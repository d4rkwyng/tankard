    "Adopt it again from Homebrew ▸ Adopt Apps…; it asks first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über Homebrew ▸ Apps übernehmen… erneut übernehmen; es wird vorher gefragt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adoptez-la à nouveau via Homebrew ▸ Adopter des apps… ; une confirmation est demandée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a adoptarla desde Homebrew ▸ Adoptar apps…; pide confirmación antes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ▸ アプリを引き継ぐ… から再度引き継げます。実行前に確認があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可通过 Homebrew ▸ 接管 App… 再次接管；操作前会先询问。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adote-o de novo em Homebrew ▸ Adotar apps…; ele pergunta antes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Adottala di nuovo da Homebrew ▸ Adotta app…; chiede prima conferma."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ▸ 앱 가져오기…에서 다시 가져올 수 있습니다. 먼저 확인을 묻습니다."
          }
        }
      }
    },
    "Adopted without a version check: %@. These apps update themselves, so brew doesn't compare the download with the app that is there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Versionsprüfung übernommen: %@. Diese Apps aktualisieren sich selbst; brew vergleicht den Download nicht mit der App."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adoptées sans vérification de version : %@. Ces apps se mettent à jour elles-mêmes, donc brew ne compare pas le téléchargement avec l'app présente."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adoptadas sin comprobar la versión: %@. Estas apps se actualizan solas, así que brew no compara la descarga con la app que ya está."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン確認なしで引き継ぎ: %@。これらのアプリは自動アップデートするため、brew はダウンロードを既存のアプリと比較しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未检查版本即接管：%@。这些 App 会自行更新，因此 brew 不会将下载内容与现有 App 进行比较。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adotados sem verificar a versão: %@. Esses apps se atualizam sozinhos, então o brew não compara o download com o app que já está lá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Adottate senza controllo della versione: %@. Queste app si aggiornano da sole, quindi brew non confronta il download con l'app presente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버전 확인 없이 가져옴: %@. 이 앱들은 스스로 업데이트하므로 brew는 다운로드를 기존 앱과 비교하지 않습니다."
          }
        }
      }
    },
