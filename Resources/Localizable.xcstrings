          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las formulae que se compilan desde el código fuente pueden fallar. La App Store actualiza Xcode."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースからビルドするformulaeは失敗することがあります。XcodeはApp Storeで更新されます。"
