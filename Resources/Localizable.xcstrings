    "Extra package catalogs added to Homebrew. Official ones are read online and don't need adding.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusätzliche Paketkataloge, die zu Homebrew hinzugefügt wurden. Die offiziellen werden online gelesen und müssen nicht hinzugefügt werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Catalogues de paquets supplémentaires ajoutés à Homebrew. Les officiels sont lus en ligne et n’ont pas besoin d’être ajoutés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Catálogos de paquetes adicionales añadidos a Homebrew. Los oficiales se leen en línea y no hace falta añadirlos."
          }
        },
        "it": {
          "stringUnit": {
