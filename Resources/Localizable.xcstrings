          "stringUnit": {
            "state": "translated",
            "value": "macOSがアプリの変更をブロックしました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 阻止了更改 App"
          }
