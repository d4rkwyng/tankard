            "state": "translated",
            "value": "Homebrew führt sie als %@; bei selbstaktualisierenden Apps vergleicht brew keine Versionen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew l'enregistre comme %@ ; brew ne compare pas les versions des apps qui se mettent à jour seules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew la registra como %@; brew no compara versiones de apps que se actualizan solas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew は %@ として記録します。自己更新するアプリについて brew はバージョンを比較しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
