    "Puts back the version Homebrew has now, which may be newer than %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Holt die Version zurück, die Homebrew jetzt hat. Sie kann neuer sein als %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
