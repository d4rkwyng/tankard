    "brew trust: \"Trust non-official tap formulae, casks or commands so Homebrew may load them.\" They are its author's Ruby code. Trust only taps whose author you trust.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "brew trust: „Trust non-official tap formulae, casks or commands so Homebrew may load them.“ Es ist der Ruby-Code des Autors. Vertraue nur Taps, deren Autor du vertraust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "brew trust : \"Trust non-official tap formulae, casks or commands so Homebrew may load them.\" Il s’agit de code Ruby de leur auteur. N’approuvez que les taps dont vous faites confiance à l’auteur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "brew trust: \"Trust non-official tap formulae, casks or commands so Homebrew may load them.\" Es código Ruby de su autor. Confía solo en taps cuyo autor te inspire confianza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brew trust: 「Trust non-official tap formulae, casks or commands so Homebrew may load them.」これらは作者のRubyコードです。作者を信頼できるtapだけを信頼してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "brew trust：“Trust non-official tap formulae, casks or commands so Homebrew may load them.” 它们是作者的 Ruby 代码。请只信任你信任其作者的 tap。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "brew trust: \"Trust non-official tap formulae, casks or commands so Homebrew may load them.\" É código Ruby do autor. Confie apenas em taps cujo autor você conhece e em quem confia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "brew trust: \"Trust non-official tap formulae, casks or commands so Homebrew may load them.\" Sono codice Ruby del loro autore. Considera attendibili solo i tap di cui ti fidi dell'autore."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "brew trust: \"Trust non-official tap formulae, casks or commands so Homebrew may load them.\" 이는 작성자의 Ruby 코드입니다. 작성자를 신뢰하는 tap만 신뢰하세요."
          }
        }
      }
    },
