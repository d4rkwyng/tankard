    "Start also registers it to launch at login.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Starten“ registriert es auch für den Start bei der Anmeldung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrer l’enregistre aussi pour un lancement à l’ouverture de session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar también lo registra para abrirse al iniciar sesión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始すると、ログイン時の起動にも登録されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
