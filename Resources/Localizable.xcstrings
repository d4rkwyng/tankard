    "Fix commands are shown, never run. Copy one into Terminal if you want it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehle zur Behebung werden nur angezeigt, nie ausgeführt. Kopiere einen ins Terminal, wenn du ihn nutzen willst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes de correction sont affichées, jamais exécutées. Copiez-en une dans Terminal si vous le souhaitez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comandos de corrección se muestran, nunca se ejecutan. Cópialo en Terminal si lo quieres."
          }
        },
        "ja": {
          "stringUnit": {
