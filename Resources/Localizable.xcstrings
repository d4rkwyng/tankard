    "Free up some space (Clean Up helps), then retry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Platz freigeben (Aufräumen hilft), dann erneut versuchen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérez de l'espace (Nettoyer aide), puis réessayez."
          }
