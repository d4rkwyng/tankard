            "state": "translated",
            "value": "macOS proporciona una versión similar, que esta ocultaría"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSが類似のバージョンを提供しており、これはそれを上書きしてしまいます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
