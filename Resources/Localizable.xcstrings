    "brew won't load formulae from third-party taps until you trust them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "brew lädt keine Formulae aus Drittanbieter-Taps, bis du ihnen vertraust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "brew ne chargera pas les formulae des taps tiers tant que vous ne les approuvez pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "brew no cargará formulae de taps de terceros hasta que confíes en ellos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼するまで、brewはサードパーティのtapからformulaを読み込みません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你信任第三方 tap 之前，brew 不会从中载入 formula。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O brew não carrega formulae de taps de terceiros até você confiar neles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "brew non caricherà formulae da tap di terze parti finché non li consideri attendibili."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰하기 전에는 brew가 서드파티 tap에서 formulae를 불러오지 않습니다."
          }
        }
      }
    },
    "brew won't uninstall a pinned formula. Unpin it first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "brew deinstalliert keine fixierte Formula. Löse zuerst die Fixierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "brew ne désinstallera pas une formula épinglée. Désépinglez-la d’abord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "brew no desinstalará una formula fijada. Desfíjala primero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brewはピン留めされたformulaをアンインストールしません。先にピン留めを解除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
