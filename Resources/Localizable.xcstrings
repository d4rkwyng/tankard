    "So the next upgrade or auto-update doesn't upgrade them again. Unpin later to get updates.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit das nächste Upgrade oder Auto-Update sie nicht erneut aktualisiert. Löse die Fixierung später, um Updates zu erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainsi, la prochaine mise à niveau ou mise à jour automatique ne les mettra pas à niveau de nouveau. Désépinglez plus tard pour recevoir les mises à jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así la próxima actualización o actualización automática no vuelve a actualizarlos. Desfija más tarde para recibir actualizaciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回のアップグレードや自動アップデートで再びアップグレードされないようにします。更新を受け取るには、後でピン留めを解除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样下次升级或自动更新就不会再升级它们。之后可取消固定以获取更新。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim a próxima atualização ou atualização automática não os atualiza de novo. Desafixe depois para receber atualizações."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così il prossimo aggiornamento o aggiornamento automatico non li aggiorna di nuovo. Sblocca più tardi per ricevere gli aggiornamenti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 업그레이드나 자동 업데이트에서 다시 업그레이드되지 않도록 합니다. 업데이트를 받으려면 나중에 고정을 해제하세요."
          }
        }
      }
    },
    "Some Homebrew folders aren't writable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Homebrew-Ordner sind nicht beschreibbar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains dossiers de Homebrew ne sont pas accessibles en écriture"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas carpetas de Homebrew no tienen permiso de escritura"
          }
        },
