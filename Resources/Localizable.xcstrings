    "%lld installed packages come from this tap (%@). Uninstall them first: brew won't remove a tap while packages from it are installed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld installierte Pakete stammen aus diesem Tap (%@). Deinstalliere sie zuerst: brew entfernt keinen Tap, solange Pakete daraus installiert sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld paquets installés proviennent de ce tap (%@). Désinstallez-les d’abord : brew ne retire pas un tap tant que des paquets qui en proviennent sont installés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld paquetes instalados provienen de este tap (%@). Desinstálalos primero: brew no quita un tap mientras haya paquetes suyos instalados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このtap(%2$@)から%1$lld個のインストール済みパッケージが来ています。先にアンインストールしてください。tapのパッケージがインストールされている間、brewはtapを削除しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 tap（%2$@）提供了 %1$lld 个已安装的软件包。请先卸载它们：只要还装有来自该 tap 的软件包，brew 就不会移除它。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pacotes instalados vêm deste tap (%@). Desinstale-os primeiro: o brew não remove um tap enquanto houver pacotes dele instalados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pacchetti installati provengono da questo tap (%@). Disinstallali prima: brew non rimuove un tap finché ci sono pacchetti installati da esso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 패키지 %lld개가 이 tap(%@)에서 왔습니다. 먼저 제거하세요. 이 tap의 패키지가 설치되어 있는 동안에는 brew가 tap을 제거하지 않습니다."
          }
        }
      }
    },
