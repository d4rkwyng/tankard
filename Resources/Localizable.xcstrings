          }
        }
      }
    },
    "The installer asks for your password and runs in Terminal. When it finishes, come back and click Check again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Installationsprogramm fragt nach deinem Passwort und läuft im Terminal. Komm danach zurück und klicke auf „Erneut prüfen“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme d’installation demande votre mot de passe et s’exécute dans Terminal. Une fois terminé, revenez et cliquez sur Vérifier à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El instalador pide tu contraseña y se ejecuta en Terminal. Cuando termine, vuelve y haz clic en Comprobar de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストーラがパスワードを求め、ターミナルで実行されます。完了したら戻って「もう一度確認」をクリックしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装程序会要求输入密码并在“终端”中运行。完成后，请回来点按“再次检查”。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O instalador pede sua senha e roda no Terminal. Quando terminar, volte e clique em Verificar novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il programma di installazione chiede la tua password e viene eseguito nel Terminale. Al termine, torna qui e clicca su Controlla di nuovo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치 프로그램이 암호를 요청하며 터미널에서 실행됩니다. 끝나면 돌아와서 다시 확인을 클릭하세요."
          }
        }
      }
    },
    "The last %lld are kept in Application Support.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten %lld werden in Application Support behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld dernières sont conservées dans Application Support."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan los últimos %lld en Application Support."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近%lld件がApplication Supportに保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 %lld 个保存在 Application Support 中。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os últimos %lld são mantidos em Application Support."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli ultimi %lld sono conservati in Application Support."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 %lld개는 Application Support에 보관됩니다."
          }
        }
      }
    },
    "The last %lld automatic runs. brew's full output is in %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die letzten %lld automatischen Läufe. Die vollständige Ausgabe von brew liegt in %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les %lld dernières exécutions automatiques. La sortie complète de brew se trouve dans %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las últimas %lld ejecuciones automáticas. La salida completa de brew está en %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直近%lld回の自動実行。brewの完全な出力は%@にあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近 %lld 次自动运行。brew 的完整输出位于 %@。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As últimas %lld execuções automáticas. A saída completa do brew está em %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ultime %lld esecuzioni automatiche. L'output completo di brew è in %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근 자동 실행 %lld건. brew의 전체 출력은 %@에 있습니다."
          }
        }
      }
    },
    "The menu-bar icon is off, so Tankard quits when you close its window, and nothing runs then.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Menüleistensymbol ist aus, daher beendet sich Tankard beim Schließen des Fensters, und nichts läuft dann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’icône de la barre des menus est désactivée : Tankard quitte donc à la fermeture de sa fenêtre, et plus rien ne s’exécute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El icono de la barra de menús está desactivado, así que Tankard se cierra al cerrar su ventana y entonces no se ejecuta nada."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーアイコンがオフのため、ウインドウを閉じるとTankardは終了し、その間は何も実行されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏图标已关闭，因此关闭窗口时 Tankard 会退出，且届时不会运行任何任务。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ícone da barra de menus está desativado, então o Tankard encerra ao fechar a janela e nada é executado depois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'icona nella barra dei menu è disattivata, quindi Tankard si chiude quando chiudi la sua finestra, e nulla viene eseguito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대 아이콘이 꺼져 있어 윈도우를 닫으면 Tankard가 종료되며, 그 후에는 아무것도 실행되지 않습니다."
          }
        }
      }
    },
    "The official installer from brew.sh.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das offizielle Installationsprogramm von brew.sh."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme d’installation officiel de brew.sh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El instalador oficial de brew.sh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brew.shの公式インストーラ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 brew.sh 的官方安装程序。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O instalador oficial de brew.sh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il programma di installazione ufficiale da brew.sh."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "brew.sh의 공식 설치 프로그램입니다."
          }
        }
      }
    },
    "The old version is still installed. brew uninstall removes the new one, then brew link links the old one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die alte Version ist noch installiert. brew uninstall entfernt die neue, dann verknüpft brew link die alte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ancienne version est toujours installée. brew uninstall supprime la nouvelle, puis brew link lie l’ancienne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión anterior sigue instalada. brew uninstall quita la nueva y luego brew link enlaza la anterior."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いバージョンはまだインストールされています。brew uninstallで新しい方を削除し、brew linkで古い方をリンクします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版本仍已安装。brew uninstall 会移除新版本，然后 brew link 会链接旧版本。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão antiga ainda está instalada. O brew uninstall remove a nova e depois o brew link vincula a antiga."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vecchia versione è ancora installata. brew uninstall rimuove la nuova, poi brew link collega la vecchia."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 버전이 아직 설치되어 있습니다. brew uninstall이 새 버전을 제거한 다음 brew link가 이전 버전을 링크합니다."
          }
        }
      }
    },
    "The variables are unset first, so this brew update doesn't put the fork back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Variablen werden zuerst zurückgesetzt, damit dieses brew update den Fork nicht zurückbringt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les variables sont d’abord supprimées, afin que ce brew update ne remette pas le fork."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las variables se desactivan primero, así que este brew update no vuelve a poner el fork."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この変数は先に解除されるため、このbrew updateでフォークが元に戻ることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些变量会先被取消设置，因此这次 brew update 不会把 fork 放回去。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As variáveis são removidas antes, para que este brew update não restaure o fork."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le variabili vengono prima rimosse, così questo brew update non rimette il fork."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변수를 먼저 해제하므로 이 brew update가 fork를 되돌려 놓지 않습니다."
          }
        }
      }
    },
    "Their commands and libraries aren't in Homebrew's prefix. Usually an install or upgrade was interrupted.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Befehle und Bibliotheken liegen nicht im Homebrew-Präfix. Meist wurde eine Installation oder ein Upgrade unterbrochen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Leurs commandes et bibliothèques ne se trouvent pas dans le préfixe de Homebrew. Généralement, une installation ou une mise à niveau a été interrompue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus comandos y bibliotecas no están en el prefijo de Homebrew. Normalmente se interrumpió una instalación o actualización."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それらのコマンドとライブラリはHomebrewのprefix内にありません。通常はインストールまたはアップグレードが中断されたことが原因です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们的命令和库不在 Homebrew 的前缀中。通常是安装或升级被中断所致。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os comandos e bibliotecas deles não estão no prefixo do Homebrew. Normalmente uma instalação ou atualização foi interrompida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I loro comandi e le loro librerie non sono nel prefisso di Homebrew. Di solito un'installazione o un aggiornamento è stato interrotto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이들의 명령과 라이브러리가 Homebrew 접두사에 없습니다. 보통 설치나 업그레이드가 중단되었기 때문입니다."
          }
        }
      }
    },
    "There are broken links in Homebrew's folders": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Ordnern von Homebrew gibt es defekte Verknüpfungen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des liens sont cassés dans les dossiers de Homebrew"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay enlaces rotos en las carpetas de Homebrew"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrewのフォルダに壊れたリンクがあります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 文件夹中有损坏的链接"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há links quebrados nas pastas do Homebrew"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sono collegamenti interrotti nelle cartelle di Homebrew"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 폴더에 깨진 링크가 있습니다"
          }
        }
      }
    },
    "There's no space left to download or unpack. Free some space (Clean Up helps), then retry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein Speicherplatz mehr zum Laden oder Entpacken da. Schaffe Platz („Bereinigen“ hilft) und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a plus assez d’espace pour télécharger ou décompresser. Libérez de l’espace (Nettoyer aide), puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No queda espacio para descargar o descomprimir. Libera espacio (Limpiar ayuda) y reintenta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードや展開に使える容量がありません。容量を空けて（クリーンアップが役立ちます）から再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有剩余空间用于下载或解包。请释放一些空间（“清理”会有帮助），然后重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço para baixar ou descompactar. Libere espaço (a Limpeza ajuda) e tente novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è spazio per scaricare o decomprimere. Libera dello spazio (Pulisci aiuta), poi riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드하거나 압축을 풀 공간이 없습니다. 공간을 확보한 다음(정리가 도움이 됩니다) 다시 시도하세요."
          }
        }
      }
    },
    "These installed packages need it. Uninstall them first, or keep %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese installierten Pakete benötigen es. Deinstalliere sie zuerst oder behalte %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces paquets installés en dépendent. Désinstallez-les d’abord, ou conservez %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos paquetes instalados lo necesitan. Desinstálalos primero, o conserva %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのこれらのパッケージが必要としています。先にアンインストールするか、%@を残してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些已安装的软件包需要它。请先卸载它们，或保留 %@。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes pacotes instalados precisam dele. Desinstale-os primeiro ou mantenha %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi pacchetti installati ne hanno bisogno. Disinstallali prima, oppure conserva %@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 이 패키지들이 필요로 합니다. 먼저 제거하거나 %@을(를) 유지하세요."
          }
        }
      }
    },
    "Third-party": {
      "localizations": {
        "de": {
          "stringUnit": {
