    "Already have apps from the web? Once Homebrew runs, Homebrew ▸ Adopt Apps… lets brew keep them up to date.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon Apps aus dem Web? Sobald Homebrew läuft, kann brew sie über Homebrew ▸ Apps übernehmen… aktuell halten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà des apps téléchargées sur le web ? Une fois Homebrew en place, Homebrew ▸ Adopter des apps… permet à brew de les tenir à jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ya tienes apps descargadas de la web? Cuando Homebrew esté listo, Homebrew ▸ Adoptar apps… permite que brew las mantenga al día."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Web から入手したアプリがありますか？ Homebrew が動作したら、Homebrew ▸ アプリを引き継ぐ… で brew に最新の状態を保たせることができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有从网上下载的 App？Homebrew 运行后，可通过 Homebrew ▸ 接管 App… 让 brew 为其保持最新。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já tem apps baixados da web? Quando o Homebrew estiver rodando, Homebrew ▸ Adotar apps… deixa o brew mantê-los atualizados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già app scaricate dal web? Quando Homebrew è attivo, Homebrew ▸ Adotta app… permette a brew di tenerle aggiornate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹에서 받은 앱이 있나요? Homebrew가 실행되면 Homebrew ▸ 앱 가져오기…로 brew가 앱을 최신 상태로 유지하게 할 수 있습니다."
          }
        }
      }
    },
