    "brew bundle didn't finish within %lld seconds, so Tankard stopped it. Homebrew may be busy or waiting on the network; try again in a moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "brew bundle wurde nicht innerhalb von %lld Sekunden fertig, daher hat Tankard es gestoppt. Homebrew ist womöglich ausgelastet oder wartet auf das Netzwerk; versuche es gleich noch einmal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "brew bundle ne s’est pas terminé en %lld secondes, Tankard l’a donc arrêté. Homebrew est peut-être occupé ou attend le réseau ; réessayez dans un instant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "brew bundle no terminó en %lld segundos, así que Tankard lo detuvo. Puede que Homebrew esté ocupado o esperando a la red; inténtalo de nuevo en un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brew bundleが%lld秒以内に終了しなかったため、Tankardが停止しました。Homebrewがビジー状態か、ネットワークを待っている可能性があります。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "brew bundle 未在 %lld 秒内完成，因此 Tankard 已将其停止。Homebrew 可能正忙或在等待网络；请稍后再试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O brew bundle não terminou em %lld segundos, então o Tankard o interrompeu. O Homebrew pode estar ocupado ou aguardando a rede; tente novamente em instantes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "brew bundle non è terminato entro %lld secondi, quindi Tankard lo ha interrotto. Homebrew potrebbe essere occupato o in attesa della rete; riprova tra un momento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "brew bundle이 %lld초 안에 끝나지 않아 Tankard가 중지했습니다. Homebrew가 바쁘거나 네트워크를 기다리는 중일 수 있습니다. 잠시 후 다시 시도하세요."
          }
        }
      }
    },
