    },
    "macOS provides a similar version, which this would shadow": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS stellt eine ähnliche Version bereit, die dadurch überdeckt würde"
          }
        },
