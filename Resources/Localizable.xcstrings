    "Stop the running brew (and everything it started) immediately": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das laufende brew (und alles, was es gestartet hat) sofort stoppen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter immédiatement le brew en cours (et tout ce qu’il a lancé)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
