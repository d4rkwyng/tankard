    },
    "Removes %@ %@. Your settings and data for it stay on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt %1$@ %2$@. Deine Einstellungen und Daten dafür bleiben auf diesem Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime %1$@ %2$@. Vos réglages et données associés restent sur ce Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita %@ %@. Sus ajustes y datos se quedan en este Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove %@ %@. Le sue impostazioni e i suoi dati restano su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ を削除します。そのアプリの設定とデータはこのMacに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@을(를) 제거합니다. 이 앱의 설정과 데이터는 이 Mac에 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 %@ %@。它的设置和数据会保留在这台 Mac 上。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %@ %@. Os ajustes e dados dele continuam neste Mac."
          }
        }
      }
    },
    "Removes Homebrew and every package installed with it: %lld formulae and %lld casks. This can't be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt Homebrew und alle damit installierten Pakete: %lld Formulae und %lld Casks. Das lässt sich nicht rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime Homebrew et tous les paquets installés avec lui : %lld formulae et %lld casks. Cette action est irréversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita Homebrew y todos los paquetes instalados con él: %lld formulae y %lld casks. No se puede deshacer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrewと、それでインストールしたすべてのパッケージ（%lld個のformulaと%lld個のcask）を削除します。この操作は取り消せません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除 Homebrew 及用它安装的所有软件包：%lld 个 formula 和 %lld 个 cask。此操作无法撤销。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove o Homebrew e todos os pacotes instalados com ele: %lld formulae e %lld casks. Isto não pode ser desfeito."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove Homebrew e tutti i pacchetti installati con esso: %lld formulae e %lld cask. Questa operazione non può essere annullata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew와 함께 설치된 모든 패키지(formula %lld개, cask %lld개)를 제거합니다. 되돌릴 수 없습니다."
          }
        }
      }
    },
    "Removes all installed versions of %@ (%@).": {
