    "Upgrade Tankard now. Automatic updates never upgrade Tankard itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard jetzt upgraden. Automatische Updates upgraden Tankard selbst nie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à niveau Tankard maintenant. Les mises à jour automatiques ne mettent jamais Tankard lui-même à niveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza Tankard ahora. Las actualizaciones automáticas nunca actualizan el propio Tankard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna Tankard ora. Gli aggiornamenti automatici non aggiornano mai Tankard stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐTankardをアップグレードします。自動アップデートでTankard自体がアップグレードされることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 Tankard를 업그레이드합니다. 자동 업데이트는 Tankard 자체를 업그레이드하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即升级 Tankard。自动更新从不会升级 Tankard 本身。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizar o Tankard agora. As atualizações automáticas nunca atualizam o próprio Tankard."
          }
        }
      }
    },
    "Upgrade again the usual way: compile warnings, pins and skipped versions still apply": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem üblichen Weg erneut upgraden: Compile-Warnungen, Fixierungen und übersprungene Versionen gelten weiterhin"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à niveau de nouveau normalement : les avertissements de compilation, les épingles et les versions ignorées s’appliquent toujours"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza de nuevo de la forma habitual: siguen aplicando las advertencias de compilación, los fijados y las versiones omitidas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常の方法でもう一度アップグレード: コンパイルの警告、ピン留め、スキップしたバージョンは引き続き適用されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按常规方式再次升级：编译警告、固定项和已跳过的版本仍然适用"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize novamente da forma habitual: avisos de compilação, fixações e versões ignoradas continuam valendo"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna di nuovo nel modo consueto: gli avvisi di compilazione, i blocchi e le versioni saltate valgono ancora"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "평소 방식으로 다시 업그레이드: 컴파일 경고, 고정, 건너뛴 버전은 계속 적용됩니다"
          }
        }
      }
    },
