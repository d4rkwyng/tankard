    },
    "Installed version is newer than the tap's %@. brew won't downgrade it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die installierte Version ist neuer als %@ im Tap. brew führt kein Downgrade durch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version installée est plus récente que celle du tap (%@). brew ne la rétrogradera pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión instalada es más reciente que la %@ del tap. brew no la degradará."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのバージョンはtapの %@ より新しいです。brewはダウングレードしません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
