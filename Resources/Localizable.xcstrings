    "brew can't update or install while it can't write there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "brew kann nichts aktualisieren oder installieren, solange es dort nicht schreiben kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "brew ne peut ni mettre à jour ni installer tant qu’il ne peut pas y écrire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "brew no puede actualizar ni instalar mientras no pueda escribir ahí."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brewは、そこに書き込めない間は更新やインストールができません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 brew 无法写入那里时，就无法更新或安装。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O brew não consegue atualizar nem instalar enquanto não puder gravar lá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "brew non può aggiornare né installare finché non può scrivere lì."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "brew는 해당 위치에 쓸 수 없으면 업데이트하거나 설치할 수 없습니다."
          }
        }
      }
    },
