    " Apps aren't checked. Scan Now checks once, whenever you ask. Off by default.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Apps werden nicht geprüft. „Jetzt scannen“ prüft einmal, wann immer du willst. Standardmäßig aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " Les apps ne sont pas vérifiées. « Analyser maintenant » lance une vérification à la demande. Désactivé par défaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": " Las apps no se comprueban. Analizar ahora comprueba una vez, cuando lo pidas. Desactivado por defecto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": " Le app non vengono controllate. Scansiona ora controlla una volta, ogni volta che lo chiedi. Disattivato per impostazione predefinita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " アプリは検査されません。「今すぐスキャン」は、指示したときに1回検査します。デフォルトではオフです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 앱은 검사하지 않습니다. 지금 검사는 요청할 때마다 한 번 검사합니다. 기본적으로 꺼져 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 不检查 App。“立即扫描”会在你需要时检查一次。默认关闭。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": " Os apps não são verificados. Verificar Agora verifica uma vez, sempre que você pedir. Desativado por padrão."
          }
        }
      }
    },
