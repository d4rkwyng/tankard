          }
        }
      }
    },
    "brew link always links the newest version left, which isn't the one in this restore point.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "brew link verknüpft immer die neueste verbliebene Version, und das ist nicht die aus diesem Wiederherstellungspunkt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "brew link lie toujours la version la plus récente restante, qui n’est pas celle de ce point de restauration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "brew link siempre enlaza la versión más reciente que queda, que no es la de este punto de restauración."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brew linkは常に残っている最新バージョンをリンクします。それはこの復元ポイントのものではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "brew link 总是链接剩余的最新版本，而不是此恢复点中的版本。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O brew link sempre vincula a versão mais nova restante, que não é a deste ponto de restauração."
          }
