          }
        }
      }
    },
    "Stop the security check. The last result is kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherheitsprüfung stoppen. Das letzte Ergebnis bleibt erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter la vérification de sécurité. Le dernier résultat est conservé."
          }
