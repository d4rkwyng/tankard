          }
        }
      }
    },
    "Starts now without the permission. macOS may stop the steps that change apps; Tankard then says so.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet jetzt ohne die Berechtigung. macOS kann die Schritte stoppen, die Apps ändern; Tankard sagt dann Bescheid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre maintenant sans l’autorisation. macOS peut bloquer les étapes qui modifient des apps ; Tankard le signale alors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza ahora sin el permiso. macOS puede detener los pasos que cambian apps; Tankard lo indica entonces."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可なしで今すぐ開始します。アプリを変更する手順は macOS に止められることがあり、その場合は Tankard が知らせます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即开始，不授予该权限。macOS 可能会阻止更改 App 的步骤；届时 Tankard 会告诉你。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Começa agora sem a permissão. O macOS pode bloquear as etapas que alteram apps; o Tankard avisa quando isso acontecer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia ora senza il permesso. macOS potrebbe bloccare i passaggi che modificano le app; in quel caso Tankard lo segnala."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "권한 없이 지금 시작합니다. macOS가 앱을 변경하는 단계를 막을 수 있으며, 그러면 Tankard가 알려 줍니다."
          }
        }
      }
    },
