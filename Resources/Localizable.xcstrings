    "Scheduled check didn't run: another Homebrew command was running. Will retry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geplante Prüfung lief nicht: Ein anderer Homebrew-Befehl lief. Wird erneut versucht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification planifiée n’a pas eu lieu : une autre commande Homebrew était en cours. Nouvel essai plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprobación programada no se ejecutó: había otro comando de Homebrew en marcha. Se reintentará."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定されたチェックは実行されませんでした: 別の Homebrew コマンドが実行中でした。あとで再試行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划的检查未运行：另一个 Homebrew 命令正在运行。稍后重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificação agendada não foi executada: outro comando do Homebrew estava em execução. Será tentada novamente."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il controllo programmato non è stato eseguito: era in corso un altro comando Homebrew. Verrà ritentato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약된 확인이 실행되지 않았습니다: 다른 Homebrew 명령이 실행 중이었습니다. 다시 시도합니다."
          }
        }
      }
    },
    "Scheduled check didn't run: offline. Will retry.": {
      "localizations": {
        "de": {
