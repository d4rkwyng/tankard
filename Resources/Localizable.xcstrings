        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안 검사를 중지합니다. 마지막 결과는 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止安全检查。保留上次的结果。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar a verificação de segurança. O último resultado é mantido."
          }
        }
      }
    },
