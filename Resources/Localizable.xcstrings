    "From its receipt: everything installed it was linked against (brew deps --installed can list fewer)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus seinem Receipt: alles Installierte, das dagegen gelinkt wurde (brew deps --installed kann weniger auflisten)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’après son reçu : tout ce qui est installé y était lié (brew deps --installed peut en lister moins)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
