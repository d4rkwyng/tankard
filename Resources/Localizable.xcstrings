    },
    "This step needs administrator rights, which Tankard can't ask for. Run this in Terminal:": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schritt erfordert Administratorrechte, die Tankard nicht anfordern kann. Führe dies im Terminal aus:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette étape nécessite des droits d’administrateur, que Tankard ne peut pas demander. Exécutez ceci dans Terminal :"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este paso requiere derechos de administrador, que Tankard no puede pedir. Ejecuta esto en Terminal:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この手順には管理者権限が必要ですが、Tankardは要求できません。ターミナルでこれを実行してください:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
