    "Adopt Apps needs Homebrew's online app list, which this Homebrew setup doesn't use.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Apps übernehmen“ braucht die Online-App-Liste von Homebrew, die dieses Homebrew-Setup nicht nutzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Adopter des apps » a besoin de la liste d’apps en ligne de Homebrew, que cette installation de Homebrew n’utilise pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adoptar apps necesita la lista de apps en línea de Homebrew, que esta configuración de Homebrew no usa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Adotta app richiede l'elenco online delle app di Homebrew, che questa configurazione di Homebrew non usa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アプリを引き継ぐ」にはHomebrewのオンラインのアプリ一覧が必要ですが、このHomebrewの設定では使用しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 가져오기에는 Homebrew의 온라인 앱 목록이 필요한데, 이 Homebrew 설정에서는 이를 사용하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“接管 App”需要 Homebrew 的在线 App 列表，而此 Homebrew 设置不使用该列表。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adotar apps precisa da lista online de apps do Homebrew, que esta configuração do Homebrew não usa."
          }
        }
      }
    },
