    "%@\nThis deletes the app that is there and installs the cask's version in its place.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nDie vorhandene App wird gelöscht und durch die Version aus dem Cask ersetzt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nL'app existante est supprimée et remplacée par la version du cask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nEsto elimina la app existente e instala en su lugar la versión del cask."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n既存のアプリを削除し、代わりに cask のバージョンをインストールします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n这会删除现有的 App，并在原位置安装 cask 的版本。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nIsso apaga o app existente e instala a versão do cask no lugar dele."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nL'app esistente viene eliminata e al suo posto viene installata la versione del cask."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n기존 앱을 삭제하고 그 자리에 cask 버전을 설치합니다."
          }
        }
      }
    },
