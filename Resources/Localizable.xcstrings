            "value": "%@ → %@: %@バージョン。手動でアップグレードしてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@：%@ 版本；请手动升级"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@: versão %@; atualize manualmente"
          }
        },
        "it": {
          "stringUnit": {
