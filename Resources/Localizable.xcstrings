    "%@ is available, but this package is pinned: brew upgrade and Upgrade All skip it. Unpin it to upgrade.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist verfügbar, aber dieses Paket ist fixiert: brew upgrade und „Alle upgraden“ überspringen es. Löse die Fixierung, um es zu upgraden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est disponible, mais ce paquet est épinglé : brew upgrade et « Tout mettre à niveau » l’ignorent. Désépinglez-le pour le mettre à niveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está disponible, pero este paquete está fijado: brew upgrade y Actualizar todo lo omiten. Desfíjalo para actualizarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は利用可能ですが、このパッケージはピン留めされているため、brew upgradeと「すべてアップグレード」ではスキップされます。アップグレードするにはピン留めを解除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已可用，但此软件包已固定：brew upgrade 和“全部升级”会跳过它。取消固定后即可升级。"
          }
        },
        "pt-BR": {
          "stringUnit": {
