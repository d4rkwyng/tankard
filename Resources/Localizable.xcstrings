            "state": "translated",
            "value": "Apps installées par vous que Homebrew peut gérer : %lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que instalaste tú y que Homebrew puede gestionar: %lld"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分でインストールしたアプリのうちHomebrewで管理できるもの: %lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自行安装、Homebrew 可以管理的 App：%lld"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps que você instalou e que o Homebrew pode gerenciar: %lld"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "App installate da te che Homebrew può gestire: %lld"
          }
        },
        "ko": {
