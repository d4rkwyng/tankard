    "%lld installed packages come from this tap (%@). Uninstall them first; brew refuses to untap while they're installed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld installierte Pakete stammen aus diesem Tap (%@). Deinstalliere sie zuerst; brew verweigert untap, solange sie installiert sind."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld paquets installés proviennent de ce tap (%@). Désinstallez-les d’abord ; brew refuse de retirer un tap tant qu’ils sont installés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld paquetes instalados provienen de este tap (%@). Desinstálalos primero; brew se niega a quitar el tap mientras estén instalados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このtap(%2$@)から%1$lld個のインストール済みパッケージが来ています。先にアンインストールしてください。インストール済みの間は、brewはuntapを拒否します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 tap（%2$@）提供了 %1$lld 个已安装的软件包。请先卸载它们；只要它们仍已安装，brew 就拒绝 untap。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pacotes instalados vêm deste tap (%@). Desinstale-os primeiro; o brew se recusa a executar untap enquanto estiverem instalados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pacchetti installati provengono da questo tap (%@). Disinstallali prima; brew rifiuta di rimuovere il tap finché sono installati."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 패키지 %lld개가 이 tap(%@)에서 왔습니다. 먼저 제거하세요. 설치되어 있는 동안에는 brew가 untap을 거부합니다."
          }
        }
      }
    },
