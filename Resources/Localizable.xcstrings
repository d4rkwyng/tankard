    "After the relaunch, Tankard offers to run it again: %@ %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Neustart bietet Tankard an, es erneut auszuführen: %1$@ %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la relance, Tankard propose de le relancer : %1$@ %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras reiniciar, Tankard ofrecerá ejecutarlo de nuevo: %1$@ %2$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動後、Tankardがもう一度実行するか確認します: %1$@ %2$@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动后，Tankard 会询问是否再次运行：%1$@ %2$@。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após reabrir, o Tankard oferece executar de novo: %1$@ %2$@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo il riavvio, Tankard propone di eseguirlo di nuovo: %1$@ %2$@."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시작한 후 Tankard가 다시 실행할지 묻습니다: %1$@ %2$@."
          }
        }
      }
    },
