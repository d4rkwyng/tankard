    "Leave %@ out of Upgrade All, the counts and auto-update. Upgrade still works by hand; a newer version clears this.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bei „Alle upgraden“, den Zählern und Auto-Update auslassen. Upgrade funktioniert weiterhin manuell; eine neuere Version hebt das auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclure %@ de « Tout mettre à niveau », des compteurs et de la mise à jour auto. La mise à niveau manuelle fonctionne toujours ; une version plus récente annule ceci."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir %@ de Actualizar todo, de los recuentos y de la actualización automática. Actualizar sigue funcionando manualmente; una versión más reciente lo revierte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を「すべてアップグレード」、カウント、自動アップデートから除外します。手動でのアップグレードは引き続き使えます。新しいバージョンが出ると解除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %@ 排除在“全部升级”、计数和自动更新之外。仍可手动升级；出现更新的版本后会自动解除。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixar %@ fora de Atualizar tudo, das contagens e da atualização automática. Atualizar ainda funciona manualmente; uma versão mais nova remove isto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Escludi %@ da Aggiorna tutto, dai conteggi e dall'aggiornamento automatico. L'aggiornamento manuale funziona ancora; una versione più recente annulla questa esclusione."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 모두 업그레이드, 개수, 자동 업데이트에서 제외합니다. 직접 업그레이드는 여전히 가능하며, 새 버전이 나오면 해제됩니다."
          }
        }
      }
    },
    "Left out, changed or done since: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgelassen, seitdem geändert oder erledigt: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissés de côté, modifiés ou faits depuis : %@"
          }
        },
