    "%@ didn't start: %@ is still running. Try again when it finishes.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nicht gestartet: %@ läuft noch. Versuche es erneut, wenn es fertig ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas démarré : %@ est toujours en cours. Réessayez quand il aura terminé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se inició: %@ sigue en ejecución. Inténtalo de nuevo cuando termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を開始できませんでした: %@ がまだ実行中です。終了してからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未启动：%@ 仍在运行。请在其完成后重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não iniciou: %@ ainda está em execução. Tente novamente quando terminar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è stato avviato: %@ è ancora in esecuzione. Riprova quando ha finito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 시작되지 않음: %@이(가) 아직 실행 중입니다. 끝난 후 다시 시도하세요."
          }
        }
      }
    },
    "%@ didn't start: Homebrew isn't ready yet. Refresh, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nicht gestartet: Homebrew ist noch nicht bereit. Aktualisiere und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a pas démarré : Homebrew n’est pas encore prêt. Actualisez, puis réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
