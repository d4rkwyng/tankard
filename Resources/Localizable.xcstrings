    "Intelbrew mode: names from the taps on this Mac, details from brew info. formulae.brew.sh isn't used: it describes upstream Homebrew.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrew-Modus: Namen aus den Taps auf diesem Mac, Details aus brew info. formulae.brew.sh wird nicht verwendet: Es beschreibt Upstream-Homebrew."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode Intelbrew : noms issus des taps de ce Mac, détails issus de brew info. formulae.brew.sh n’est pas utilisé : il décrit Homebrew amont."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Intelbrew: nombres de los taps de este Mac, detalles de brew info. No se usa formulae.brew.sh: describe el Homebrew upstream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrewモード: 名前はこのMac上のtapから、詳細は brew info から取得します。formulae.brew.sh は使いません。アップストリームのHomebrewについて記述しているためです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrew 模式：名称来自这台 Mac 上的 tap，详细信息来自 brew info。不使用 formulae.brew.sh：它描述的是上游 Homebrew。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modo Intelbrew: nomes dos taps neste Mac, detalhes do brew info. formulae.brew.sh não é usado: ele descreve o Homebrew upstream."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modalità Intelbrew: nomi dai tap su questo Mac, dettagli da brew info. formulae.brew.sh non viene usato: descrive l'Homebrew upstream."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrew 모드: 이름은 이 Mac의 tap에서, 상세 정보는 brew info에서 가져옵니다. formulae.brew.sh는 upstream Homebrew를 설명하므로 사용하지 않습니다."
          }
        }
      }
    },
    "Intelbrew settings found but homebrew/core's origin is %@: run `brew update` to switch it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrew-Einstellungen gefunden, aber der Ursprung von homebrew/core ist %@: Führe `brew update` aus, um umzuschalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages Intelbrew trouvés mais l’origine de homebrew/core est %@ : exécutez `brew update` pour la changer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontraron ajustes de Intelbrew pero el origen de homebrew/core es %@: ejecuta `brew update` para cambiarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrewの設定が見つかりましたが、homebrew/core のoriginは %@ です: `brew update` を実行して切り替えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现 Intelbrew 设置，但 homebrew/core 的来源是 %@：请运行 `brew update` 来切换。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes do Intelbrew encontrados, mas a origem do homebrew/core é %@: execute `brew update` para trocá-la."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni di Intelbrew trovate ma l'origine di homebrew/core è %@: esegui `brew update` per cambiarla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrew 설정이 있지만 homebrew/core의 origin이 %@입니다: `brew update`를 실행해 전환하세요."
          }
        }
      }
    },
    "Intelbrew settings found but there is no local homebrew/core tap (API mode): run `brew tap homebrew/core` and `brew update`.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrew-Einstellungen gefunden, aber es gibt keinen lokalen Tap homebrew/core (API-Modus): Führe `brew tap homebrew/core` und `brew update` aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages Intelbrew trouvés mais il n’y a pas de tap homebrew/core local (mode API) : exécutez `brew tap homebrew/core` puis `brew update`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontraron ajustes de Intelbrew pero no hay un tap local de homebrew/core (modo API): ejecuta `brew tap homebrew/core` y `brew update`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrewの設定が見つかりましたが、ローカルの homebrew/core tapがありません(APIモード): `brew tap homebrew/core` と `brew update` を実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现 Intelbrew 设置，但没有本地 homebrew/core tap（API 模式）：请运行 `brew tap homebrew/core` 和 `brew update`。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustes do Intelbrew encontrados, mas não há tap homebrew/core local (modo API): execute `brew tap homebrew/core` e `brew update`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostazioni di Intelbrew trovate ma non c'è un tap homebrew/core locale (modalità API): esegui `brew tap homebrew/core` e `brew update`."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrew 설정이 있지만 로컬 homebrew/core tap이 없습니다(API 모드): `brew tap homebrew/core`와 `brew update`를 실행하세요."
          }
        }
      }
    },
    "Intelbrew update available (%@; %@ is out)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrew-Update verfügbar (%1$@; %2$@ ist erschienen)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour d’Intelbrew disponible (%1$@ ; %2$@ est sortie)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualización de Intelbrew disponible (%@; ya salió %@)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamento di Intelbrew disponibile (%@; è uscita la %@)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrewのアップデートがあります(%1$@。%2$@ が公開されています)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrew 업데이트 있음(%1$@, %2$@ 출시됨)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrew 有可用更新（%1$@；%2$@ 已发布）"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualização do Intelbrew disponível (%1$@; %2$@ já saiu)"
          }
        }
      }
    },
    "Intelbrew's lines stay in your shell profile (%@); remove them by hand afterwards, or use Revert to Standard Homebrew first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeilen von Intelbrew bleiben in deinem Shell-Profil (%@); entferne sie danach von Hand oder nutze zuerst „Zu Standard-Homebrew zurückkehren“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes d’Intelbrew restent dans votre profil shell (%@) ; supprimez-les ensuite manuellement, ou utilisez d’abord « Revenir à Homebrew standard »."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las líneas de Intelbrew siguen en tu perfil de shell (%@); quítalas manualmente después, o usa antes Volver a Homebrew estándar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrewの行はシェルプロファイル(%@)に残ります。後で手動で削除するか、先に「標準のHomebrewに戻す」を使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrew 的相关行仍保留在你的 shell 配置文件（%@）中；请事后手动移除，或先使用“还原为标准 Homebrew”。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As linhas do Intelbrew permanecem no perfil do shell (%@); remova-as manualmente depois, ou use antes Reverter para o Homebrew Padrão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le righe di Intelbrew restano nel profilo della shell (%@); rimuovile manualmente dopo, oppure usa prima Torna a Homebrew standard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Intelbrew 줄은 셸 프로파일(%@)에 남아 있습니다. 나중에 직접 제거하거나 먼저 표준 Homebrew로 되돌리기를 사용하세요."
          }
        }
      }
    },
    "It deletes %@'s Homebrew files and every installed formula and cask, including apps installed as casks in /Applications. Another Homebrew on this Mac (in a different prefix) is left alone. It may ask for your password.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es löscht die Homebrew-Dateien von %@ und jede installierte Formula und jeden Cask, einschließlich als Casks installierter Apps in /Applications. Ein anderes Homebrew auf diesem Mac (in einem anderen Präfix) bleibt unberührt. Es fragt eventuell nach deinem Passwort."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime les fichiers Homebrew de %@ et toutes les formules et casks installés, y compris les apps installées comme casks dans /Applications. Un autre Homebrew sur ce Mac (dans un autre préfixe) n’est pas touché. Votre mot de passe peut être demandé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina los archivos de Homebrew de %@ y todas las formulae y casks instalados, incluidas las apps instaladas como casks en /Applications. Otro Homebrew en este Mac (en un prefijo distinto) no se toca. Puede pedir tu contraseña."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のHomebrewファイルと、/Applications にcaskとしてインストールされたアプリを含め、インストール済みのすべてのformulaとcaskを削除します。このMac上の別のHomebrew(別のプレフィックス)には手を触れません。パスワードを求められる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会删除 %@ 的 Homebrew 文件以及所有已安装的 formula 和 cask，包括作为 cask 安装在 /Applications 中的 App。这台 Mac 上的其他 Homebrew（位于不同前缀）不受影响。它可能会要求输入密码。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui os arquivos do Homebrew de %@ e todas as formulae e casks instalados, inclusive apps instalados como casks em /Applications. Outro Homebrew neste Mac (em outro prefixo) não é afetado. Pode pedir sua senha."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina i file Homebrew di %@ e ogni formula e cask installati, incluse le app installate come cask in /Applications. Un altro Homebrew su questo Mac (in un prefisso diverso) non viene toccato. Potrebbe chiedere la password."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 Homebrew 파일과 설치된 모든 formula와 cask를 삭제하며, /Applications에 cask로 설치된 앱도 포함됩니다. 이 Mac의 다른 prefix에 있는 Homebrew는 건드리지 않습니다. 암호를 요청할 수 있습니다."
          }
        }
      }
    },
    "It is still installed (brew list shows it). Trusting its tap, or installing it again under its new name, lets Homebrew read it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist weiterhin installiert (brew list zeigt es). Wenn du seinem Tap vertraust oder es unter seinem neuen Namen neu installierst, kann Homebrew es wieder lesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est toujours installé (brew list l’affiche). Faire confiance à son tap, ou le réinstaller sous son nouveau nom, permet à Homebrew de le lire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue instalado (brew list lo muestra). Confiar en su tap, o instalarlo de nuevo con su nombre nuevo, permite que Homebrew lo lea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールされたままです（brew list に表示されます）。Tap を信頼するか、新しい名前で再インストールすると Homebrew が読み込めるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它仍处于安装状态（brew list 会列出它）。信任它的 Tap，或以新名称重新安装，Homebrew 就能读取它。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele continua instalado (o brew list mostra). Confiar no tap dele, ou instalá-lo de novo com o nome novo, permite que o Homebrew o leia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È ancora installato (brew list lo mostra). Fidarsi del suo tap, o reinstallarlo con il nuovo nome, permette a Homebrew di leggerlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여전히 설치되어 있습니다(brew list에 표시됨). Tap을 신뢰하거나 새 이름으로 다시 설치하면 Homebrew가 읽을 수 있습니다."
          }
        }
      }
    },
    "It took %@; expect longer on an older Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das dauerte %@; auf einem älteren Mac länger."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela a pris %@ ; comptez plus longtemps sur un Mac plus ancien."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tardó %@; espera más tiempo en un Mac más antiguo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@かかりました。古いMacではもっとかかります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "耗时 %@；在较旧的 Mac 上会更久。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levou %@; espere mais tempo em um Mac mais antigo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha richiesto %@; aspettati tempi più lunghi su un Mac meno recente."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 걸렸습니다. 오래된 Mac에서는 더 오래 걸립니다."
          }
        }
      }
    },
    "It was built from the latest source, so there is no fixed version to go back to.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde aus dem neuesten Quellcode gebaut, daher gibt es keine feste Version, zu der man zurückkehren kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a été compilé depuis les sources les plus récentes, il n’y a donc pas de version fixe à laquelle revenir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se compiló desde el código fuente más reciente, así que no hay una versión fija a la que volver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato compilato dai sorgenti più recenti, quindi non c'è una versione fissa a cui tornare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のソースからビルドされたため、戻る先の固定バージョンがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 소스에서 빌드되어 되돌아갈 고정된 버전이 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它是从最新源码构建的，因此没有可以退回的固定版本。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi compilado do código-fonte mais recente, então não há uma versão fixa para a qual voltar."
          }
        }
      }
    },
    "It was stopped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wurde gestoppt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle a été arrêtée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detuvo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已被停止。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi interrompido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato interrotto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중지되었습니다."
          }
        }
      }
    },
    "It's pinned. Unpin it first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist fixiert. Löse zuerst die Fixierung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est épinglé. Désépinglez-le d’abord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está fijado. Desfíjalo primero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È bloccato. Sbloccalo prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めされています。先にピン留めを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정되어 있습니다. 먼저 고정을 해제하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它已固定。请先取消固定。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Está fixado. Desafixe primeiro."
          }
        }
      }
    },
    "Its dependencies stay installed (brew autoremove removes unused ones)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Abhängigkeiten bleiben installiert (brew autoremove entfernt ungenutzte)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses dépendances restent installées (brew autoremove supprime celles inutilisées)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus dependencias siguen instaladas (brew autoremove elimina las que no se usan)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依存関係はインストールされたままです(brew autoremove で未使用のものを削除できます)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
