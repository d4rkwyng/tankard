    },
    "Another Homebrew command kept brew's lock. Retry once it has finished.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Homebrew-Befehl hielt die Sperre. Erneut versuchen, wenn er fertig ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une autre commande Homebrew gardait le verrou de brew. Réessayez une fois qu'elle a terminé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro comando de Homebrew mantenía el bloqueo de brew. Reintenta cuando haya terminado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の Homebrew コマンドが brew のロックを保持していました。終了後に再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个 Homebrew 命令占用了 brew 的锁。请在它完成后重试。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro comando do Homebrew manteve o bloqueio do brew. Tente de novo quando ele terminar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro comando Homebrew teneva il blocco di brew. Riprova quando ha finito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 Homebrew 명령이 brew 잠금을 쥐고 있었습니다. 끝난 뒤 다시 시도하세요."
          }
        }
      }
    },
    "Another installer put files in Homebrew's prefix. They can confuse builds from source.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderes Installationsprogramm hat Dateien im Präfix von Homebrew abgelegt. Sie können Builds aus Quellcode stören."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre installeur a placé des fichiers dans le préfixe de Homebrew. Ils peuvent perturber les compilations depuis les sources."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro instalador puso archivos en el prefijo de Homebrew. Pueden confundir las compilaciones desde el código fuente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のインストーラがHomebrewのプレフィックスにファイルを置きました。ソースからのビルドに支障が出ることがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "另一个安装程序在 Homebrew 的前缀中放入了文件。它们可能干扰从源码构建。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro instalador colocou arquivos no prefixo do Homebrew. Eles podem atrapalhar compilações do código-fonte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro installer ha messo file nel prefisso di Homebrew. Possono confondere le compilazioni dai sorgenti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 설치 프로그램이 Homebrew의 prefix에 파일을 넣었습니다. 소스 빌드에 문제가 생길 수 있습니다."
          }
        }
      }
    },
