    "brew install gets the version Homebrew has now, which may be newer than %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "brew install holt die Version, die Homebrew jetzt hat; sie kann neuer sein als %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "brew install installe la version actuelle de Homebrew, qui peut être plus récente que %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "brew install obtiene la versión que Homebrew tiene ahora, que puede ser más reciente que %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brew installはHomebrewの現在のバージョンを取得します。%@より新しい場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
