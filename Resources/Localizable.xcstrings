          }
        }
      }
    },
    "%@ is available, but brew won't upgrade a pinned package. Upgrade all leaves it out. Unpin to upgrade it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist verfügbar, aber brew führt für ein angeheftetes Paket kein Upgrade aus. „Alle aktualisieren“ lässt es aus. Löse die Anheftung, um es zu aktualisieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est disponible, mais brew ne met pas à niveau un paquet épinglé. « Tout mettre à niveau » l’ignore. Désépinglez-le pour le mettre à niveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está disponible, pero brew no actualiza un paquete fijado. Actualizar todo lo omite. Desfíjalo para actualizarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は利用可能ですが、brewはピン留めされたパッケージをアップグレードしません。「すべてアップグレード」からも除外されます。アップグレードするにはピン留めを解除してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 有可用更新，但 brew 不会升级已固定的软件包。“全部升级”会跳过它。取消固定后即可升级。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está disponível, mas o brew não atualiza um pacote fixado. Atualizar tudo o ignora. Desafixe para atualizar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è disponibile, ma brew non aggiorna un pacchetto bloccato. Aggiorna tutto lo esclude. Sblocca per aggiornarlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 업그레이드가 가능하지만 brew는 고정된 패키지를 업그레이드하지 않습니다. 모두 업그레이드에서도 제외됩니다. 업그레이드하려면 고정을 해제하세요."
          }
        }
      }
    },
