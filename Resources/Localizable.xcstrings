    "You may use this one directly in Terminal. Untick it to keep it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nutzt dieses Paket vielleicht direkt im Terminal. Entferne das Häkchen, um es zu behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous utilisez peut-être celui-ci directement dans Terminal. Décochez-le pour le garder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que uses este directamente en Terminal. Desmárcalo para conservarlo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potresti usarlo direttamente nel Terminale. Deselezionalo per tenerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルで直接使っている可能性があります。残すにはチェックを外してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널에서 직접 사용할 수도 있습니다. 남기려면 체크를 해제하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
