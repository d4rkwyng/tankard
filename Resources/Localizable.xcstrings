          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 无法写入其文件夹"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew não conseguiu gravar em suas pastas"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew non è riuscito a scrivere nelle sue cartelle"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew가 폴더에 쓸 수 없음"
          }
        }
      }
    },
    "Homebrew is the package manager for macOS: it installs command-line tools and apps and keeps them up to date. Tankard is a window onto it, so it needs Homebrew first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ist der Paketmanager für macOS: Er installiert Befehlszeilenprogramme und Apps und hält sie aktuell. Tankard ist ein Fenster dazu, daher braucht es zuerst Homebrew."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew est le gestionnaire de paquets de macOS : il installe des outils en ligne de commande et des apps et les tient à jour. Tankard en est une fenêtre, donc il faut d’abord Homebrew."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew es el gestor de paquetes de macOS: instala herramientas de línea de comandos y apps y las mantiene al día. Tankard es una ventana a él, así que primero necesita Homebrew."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HomebrewはmacOS用のパッケージマネージャです。コマンドラインツールやアプリをインストールし、最新に保ちます。Tankardはそのウインドウなので、先にHomebrewが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 是 macOS 的软件包管理器：它安装命令行工具和 App，并使其保持最新。Tankard 是它的图形窗口，因此需要先安装 Homebrew。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew é o gerenciador de pacotes do macOS: instala ferramentas de linha de comando e apps e os mantém atualizados. O Tankard é uma janela para ele, então precisa do Homebrew primeiro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew è il gestore di pacchetti per macOS: installa strumenti da riga di comando e app e li tiene aggiornati. Tankard è una finestra su di esso, quindi serve prima Homebrew."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew는 macOS용 패키지 관리자로, 명령줄 도구와 앱을 설치하고 최신 상태로 유지합니다. Tankard는 그 위에 얹은 윈도우이므로 먼저 Homebrew가 필요합니다."
          }
        }
      }
    },
