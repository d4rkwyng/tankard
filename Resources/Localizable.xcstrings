    "Run in Terminal if you need this version. brew version-install puts it in your own tap, and you maintain it from then on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Terminal ausführen, wenn du diese Version brauchst. brew version-install legt sie in deinem eigenen Tap ab, und du pflegst sie danach selbst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez-la dans Terminal si vous avez besoin de cette version. brew version-install la place dans votre propre tap, que vous maintenez ensuite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecútalo en Terminal si necesitas esta versión. brew version-install la coloca en tu propio tap y a partir de entonces la mantienes tú."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンが必要な場合はターミナルで実行してください。brew version-installは自分のtapにインストールし、以降は自分で管理することになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果需要此版本，请在“终端”中运行。brew version-install 会把它放入你自己的 tap，此后由你自行维护。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute no Terminal se precisar desta versão. O brew version-install a coloca no seu próprio tap, e a manutenção passa a ser sua."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui nel Terminale se ti serve questa versione. brew version-install la inserisce nel tuo tap, e da quel momento la mantieni tu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전이 필요하면 터미널에서 실행하세요. brew version-install은 사용자의 tap에 넣으며, 이후 관리는 직접 해야 합니다."
          }
        }
      }
    },
    "Run it again from Homebrew ▸ Taps…; it asks first.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe es erneut über Homebrew ▸ Taps… aus; es fragt vorher nach."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relancez-le depuis Homebrew ▸ Taps… ; une confirmation est demandée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a ejecutarlo desde Homebrew ▸ Taps…; antes pregunta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ▸ Tap… からもう一度実行してください。先に確認があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
