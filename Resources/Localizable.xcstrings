    "Stop brew vulns. The last result, if any, is kept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "brew vulns stoppen. Das letzte Ergebnis, falls vorhanden, bleibt erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter brew vulns. Le dernier résultat, s’il existe, est conservé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detiene brew vulns. Se conserva el último resultado, si lo hay."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brew vulnsを停止します。前回の結果がある場合は保持されます。"
