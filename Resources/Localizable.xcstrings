    },
    "%@ → %@: versions can't be compared, so only \"All versions\" upgrades it; upgrade by hand": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@: Versionen lassen sich nicht vergleichen, daher aktualisiert nur „Alle Versionen“ es; manuell aktualisieren"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@ : les versions ne sont pas comparables, donc seul « Toutes les versions » le met à niveau ; à faire manuellement"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@: las versiones no se pueden comparar, así que solo \"Todas las versiones\" lo actualiza; actualiza manualmente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@: バージョンを比較できないため、「すべてのバージョン」でのみアップグレードされます。手動でアップグレードしてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@：无法比较版本，因此只有“所有版本”会升级它；请手动升级"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@: as versões não podem ser comparadas, então só \"Todas as versões\" o atualiza; atualize manualmente"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@: le versioni non sono confrontabili, quindi solo \"Tutte le versioni\" lo aggiorna; aggiorna manualmente"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ → %@: 버전을 비교할 수 없어 \"모든 버전\"에서만 업그레이드됩니다. 직접 업그레이드하세요"
          }
        }
      }
    },
    "%@. Due now: runs when the Mac is on AC power and idle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Fällig: läuft, wenn der Mac am Netzteil hängt und im Leerlauf ist"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Dû maintenant : s’exécute quand le Mac est sur secteur et inactif"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@. Pendiente: se ejecuta cuando el Mac está conectado a la corriente y inactivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。期限到来: MacがAC電源に接続され、アイドル状態のときに実行されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@。已到期：Mac 接通交流电且空闲时运行"
          }
        },
        "pt-BR": {
          "stringUnit": {
