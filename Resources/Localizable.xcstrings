    "What %@ needs, and what those need in turn": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was %@ braucht und was diese wiederum brauchen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dont %@ a besoin, et ce dont ceux-ci ont besoin à leur tour"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que necesita %@, y lo que esos necesitan a su vez"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che serve a %@, e ciò che serve a sua volta a quelli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が必要とするもの、さらにそれらが必要とするもの"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 필요한 항목과 그 항목들에 다시 필요한 항목"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要的内容，以及这些内容又需要的内容"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Do que %@ precisa, e do que esses itens precisam por sua vez"
          }
        }
      }
    },
