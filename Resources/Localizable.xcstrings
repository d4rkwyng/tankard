          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard (데모)"
          }
        }
      }
    },
    "Tankard Help": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard-Hilfe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide Tankard"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
