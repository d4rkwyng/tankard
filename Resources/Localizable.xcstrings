    "Deep purple and amber, like the icon. Dark underneath.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiefes Violett und Bernstein, wie das Symbol. Darunter dunkel."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Violet profond et ambre, comme l’icône. Sombre en dessous."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Morado intenso y ámbar, como el icono. Oscuro por debajo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンと同じ、深い紫とアンバー。下地はダーク。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "深紫与琥珀色，如同图标。底层为深色。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Roxo profundo e âmbar, como o ícone. Escuro por baixo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viola intenso e ambra, come l'icona. Scuro di base."
          }
        },
        "ko": {
