    "Tankard itself is never upgraded automatically: use brew upgrade --cask tankard.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard selbst wird nie automatisch aktualisiert: nutze brew upgrade --cask tankard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard n’est jamais mis à niveau automatiquement : utilisez brew upgrade --cask tankard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard nunca se actualiza a sí mismo automáticamente: usa brew upgrade --cask tankard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard自体は自動ではアップグレードされません。brew upgrade --cask tankard を使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 本身不会被自动升级：请使用 brew upgrade --cask tankard。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O próprio Tankard nunca é atualizado automaticamente: use brew upgrade --cask tankard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard stesso non viene mai aggiornato automaticamente: usa brew upgrade --cask tankard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 자체는 자동으로 업그레이드되지 않습니다. brew upgrade --cask tankard를 사용하세요."
          }
        }
      }
