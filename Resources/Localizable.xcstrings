          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 업그레이드가 끝나지 않았습니다"
          }
        }
      }
    },
    "The log below shows what brew printed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Protokoll unten zeigt, was brew ausgegeben hat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
