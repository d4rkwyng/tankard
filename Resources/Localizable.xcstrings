    "Installing compiles from source, which can take a long time on older Macs.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Installation kompiliert aus Quellcode, was auf älteren Macs lange dauern kann."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’installation compile depuis les sources, ce qui peut prendre beaucoup de temps sur les Mac plus anciens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar compila desde el código fuente, lo que puede tardar mucho en Macs más antiguos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールはソースからコンパイルされるため、古いMacでは時間がかかる場合があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装时会从源码编译，这在较旧的 Mac 上可能需要很长时间。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar compila do código-fonte, o que pode demorar muito em Macs mais antigos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installazione compila dai sorgenti, il che può richiedere molto tempo sui Mac meno recenti."
          }
