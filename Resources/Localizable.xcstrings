    "Default uses Settings ▸ Upgrades ▸ Include self-updating apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Standard“ folgt Einstellungen ▸ Upgrades ▸ Selbstaktualisierende Apps einbeziehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Par défaut » suit Réglages ▸ Mises à niveau ▸ Inclure les apps à mise à jour automatique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Predeterminado» sigue Ajustes ▸ Actualizaciones ▸ Incluir apps que se actualizan solas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「デフォルト」は 設定 ▸ アップグレード ▸ 自己更新するアプリを含める に従います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“默认”遵循 设置 ▸ 升级 ▸ 包含自行更新的 App。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“Padrão” segue Ajustes ▸ Atualizações ▸ Incluir apps que se atualizam sozinhos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Predefinito” segue Impostazioni ▸ Aggiornamenti ▸ Includi app che si aggiornano da sole."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘기본값’은 설정 ▸ 업그레이드 ▸ 자체 업데이트 앱 포함을 따릅니다."
          }
        }
      }
    },
    "Deletes %@ from Applications. Your settings and data for it stay on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht %@ aus „Programme“. Deine Einstellungen und Daten dafür bleiben auf diesem Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime %@ du dossier Applications. Vos réglages et données associés restent sur ce Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina %@ de Aplicaciones. Sus ajustes y datos se quedan en este Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina %@ da Applicazioni. Le sue impostazioni e i suoi dati restano su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をアプリケーションから削除します。そのアプリの設定とデータはこのMacに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응용 프로그램에서 %@을(를) 삭제합니다. 이 앱의 설정과 데이터는 이 Mac에 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
