          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El último análisis (%@) no encontró ninguna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のスキャン（%@）では見つかりませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
