    "Background services from installed formulae. Tankard controls your own (~/Library/LaunchAgents), never root's.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hintergrunddienste installierter Formulae. Tankard steuert deine eigenen (~/Library/LaunchAgents), nie die von root."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Services en arrière-plan des formules installées. Tankard gère les vôtres (~/Library/LaunchAgents), jamais ceux de root."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Servicios en segundo plano de las formulae instaladas. Tankard controla los tuyos (~/Library/LaunchAgents), nunca los de root."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みformulaeのバックグラウンドサービス。Tankardは自分のもの(~/Library/LaunchAgents)を制御し、rootのものは制御しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装 formula 的后台服务。Tankard 只控制你自己的服务（~/Library/LaunchAgents），不会控制 root 的。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviços em segundo plano de formulae instaladas. O Tankard controla os seus (~/Library/LaunchAgents), nunca os do root."
          }
        },
        "it": {
