        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스에서 빌드됨"
          }
        }
      }
    },
    "Built from source, but %@ has a bottle for this Mac (%@). Replacing it pours the bottle instead; the version stays the same.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Quellcode gebaut, aber %@ hat eine Bottle für diesen Mac (%@). Beim Ersetzen wird stattdessen die Bottle eingespielt; die Version bleibt gleich."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compilé depuis les sources, mais %@ a une bottle pour ce Mac (%@). Le remplacer installe la bottle à la place ; la version reste la même."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compilado desde el código fuente, pero %@ tiene un bottle para este Mac (%@). Al reemplazarlo se vierte el bottle; la versión sigue siendo la misma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースからビルドされていますが、%@ にはこのMac用のbottleがあります(%@)。置き換えるとbottleが展開されます。バージョンは変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从源码构建，但 %@ 有适用于这台 Mac 的 bottle（%@）。替换后将改用 bottle 安装；版本保持不变。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compilado do código-fonte, mas %@ tem um bottle para este Mac (%@). Reinstalar usa o bottle; a versão continua a mesma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compilato dai sorgenti, ma %@ ha una bottle per questo Mac (%@). Sostituirlo installa la bottle; la versione resta la stessa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스에서 빌드되었지만 %@에는 이 Mac용 bottle(%@)이 있습니다. 교체하면 대신 bottle을 사용하며 버전은 그대로입니다."
          }
        }
      }
    },
    "Built from source, but %@ has a bottle for this Mac. Replacing it pours the bottle instead; the version stays the same.": {
      "localizations": {
