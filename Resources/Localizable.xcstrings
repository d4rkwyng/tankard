    "This brew has no `brew vulns` (it is new in Homebrew 7). Run `brew update` to get it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses brew hat kein `brew vulns` (neu in Homebrew 7). Führe `brew update` aus, um es zu erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce brew n’a pas `brew vulns` (nouveau dans Homebrew 7). Exécutez `brew update` pour l’obtenir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este brew no tiene `brew vulns` (es nuevo en Homebrew 7). Ejecuta `brew update` para obtenerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このbrewには `brew vulns` がありません（Homebrew 7で追加）。`brew update` で入手してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 brew 没有 `brew vulns`（它是 Homebrew 7 的新增功能）。请运行 `brew update` 获取。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este brew não tem `brew vulns` (novo no Homebrew 7). Execute `brew update` para obtê-lo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo brew non ha `brew vulns` (è nuovo in Homebrew 7). Esegui `brew update` per ottenerlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 brew에는 `brew vulns`가 없습니다(Homebrew 7에서 새로 추가됨). `brew update`를 실행하여 받으세요."
          }
        }
      }
    },
    "This macOS version isn't supported by Homebrew": {
