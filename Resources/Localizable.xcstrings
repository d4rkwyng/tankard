    "Sends your installed formula names and versions to OSV.dev (via brew vulns).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet die Namen und Versionen deiner installierten Formulae an OSV.dev (über brew vulns)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie les noms et versions de vos formulae installées à OSV.dev (via brew vulns)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía los nombres y versiones de tus formulae instaladas a OSV.dev (mediante brew vulns)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みformulaの名前とバージョンをOSV.dev（brew vulns経由）に送信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将你已安装的 formula 名称和版本发送到 OSV.dev（通过 brew vulns）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia os nomes e versões das suas formulae instaladas ao OSV.dev (via brew vulns)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia i nomi e le versioni delle formula installate a OSV.dev (tramite brew vulns)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 formula 이름과 버전을 OSV.dev로 보냅니다(brew vulns 사용)."
          }
        }
      }
    },
