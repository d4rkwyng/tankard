    "%@ has nothing left to upgrade.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat keine ausstehenden Upgrades mehr."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a plus rien à mettre à niveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no tiene nada más que actualizar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にはアップグレードするものがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已无可升级内容。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não tem mais nada para atualizar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha più nulla da aggiornare."
          }
        },
        "ko": {
          "stringUnit": {
