    "Turn on Tankard. If it isn't listed, click + and choose Tankard in Applications.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Tankard ein. Falls es nicht aufgeführt ist, klicke auf + und wähle Tankard im Ordner „Programme“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Tankard. S’il n’est pas listé, cliquez sur + et choisissez Tankard dans Applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Tankard. Si no aparece en la lista, haz clic en + y elige Tankard en Aplicaciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankardをオンにします。一覧にない場合は、+をクリックしてアプリケーションからTankardを選んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启 Tankard。如果列表中没有，请点按 + 并在“应用程序”中选择 Tankard。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Tankard. Se não estiver na lista, clique em + e escolha o Tankard em Aplicativos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Tankard. Se non è nell'elenco, clicca + e scegli Tankard in Applicazioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard를 켜세요. 목록에 없으면 +를 클릭하고 응용 프로그램에서 Tankard를 선택하세요."
          }
        }
      }
    },
