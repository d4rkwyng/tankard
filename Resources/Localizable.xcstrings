    "Removes old versions and leftover downloads, after showing what goes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt alte Versionen und übrig gebliebene Downloads und zeigt vorher, was wegkommt"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime les anciennes versions et les téléchargements restants, après avoir montré ce qui part"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita versiones anteriores y descargas sobrantes, tras mostrar lo que se va a quitar"
          }
