    "Homebrew still has it, but will disable it later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew hat es noch, wird es aber später deaktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew l’a encore, mais le désactivera plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew aún lo tiene, pero lo deshabilitará más adelante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrewにはまだありますが、後で無効化されます。"
          }
        },
        "zh-Hans": {
