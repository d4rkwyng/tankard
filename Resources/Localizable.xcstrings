            "value": "brewは--installedを使用: これを必要とするインストール済みパッケージ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "brew 使用 --installed：需要它的已安装软件包"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O brew usa --installed: pacotes instalados que precisam dele"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "brew usa --installed: pacchetti installati che ne hanno bisogno"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "brew는 --installed를 사용합니다: 이를 필요로 하는 설치된 패키지"
          }
        }
      }
    },
    "brew won't load formulae from third-party taps until you trust them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "brew lädt keine Formulae aus Drittanbieter-Taps, bis du ihnen vertraust."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "brew ne chargera pas les formulae des taps tiers tant que vous ne les approuvez pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "brew no cargará formulae de taps de terceros hasta que confíes en ellos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼するまで、brewはサードパーティのtapからformulaを読み込みません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你信任第三方 tap 之前，brew 不会从中载入 formula。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O brew não carrega formulae de taps de terceiros até você confiar neles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "brew non caricherà formulae da tap di terze parti finché non li consideri attendibili."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰하기 전에는 brew가 서드파티 tap에서 formulae를 불러오지 않습니다."
          }
        }
      }
    },
    "brew won't upgrade it, and Upgrade All leaves it out.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "brew upgradet es nicht, und „Alle upgraden“ lässt es aus."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "brew ne la mettra pas à niveau et Tout mettre à niveau l’exclut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "brew no la actualizará, y Actualizar todo la deja fuera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brewはアップグレードせず、すべてアップグレードにも含まれません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "brew 不会升级它，“全部升级”也不包含它。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O brew não a atualiza e Atualizar tudo a deixa de fora."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "brew non lo aggiorna, e Aggiorna tutto lo esclude."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "brew가 업그레이드하지 않으며, 모두 업그레이드에서도 제외됩니다."
