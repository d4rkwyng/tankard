    },
    "macOS applies App Management the next time Tankard starts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS wendet die App-Verwaltung beim nächsten Start von Tankard an."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS applique Gestion des apps au prochain lancement de Tankard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS aplica Gestión de apps la próxima vez que se abra Tankard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSはTankardの次回起動時にApp管理を適用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会在 Tankard 下次启动时应用“App 管理”权限。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS aplica o Gerenciamento de Apps na próxima vez que o Tankard abrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS applica Gestione app al prossimo avvio di Tankard."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 Tankard가 다음에 시작될 때 앱 관리 권한을 적용합니다."
          }
        }
      }
    },
    "macOS asks before Tankard can install, update or remove apps in Applications. Turn on Tankard in Privacy & Security → App Management.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt, bevor Tankard Apps installieren, aktualisieren oder entfernen darf. Schalte Tankard unter „Datenschutz & Sicherheit“ → „App-Verwaltung“ ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande avant que Tankard puisse installer, mettre à jour ou supprimer des apps dans Applications. Activez Tankard dans Confidentialité et sécurité → Gestion des apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pregunta antes de que Tankard pueda instalar, actualizar o eliminar apps en Aplicaciones. Activa Tankard en Privacidad y seguridad → Gestión de apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSは、Tankardが「アプリケーション」内のアプリをインストール、アップデート、削除する前に確認します。「プライバシーとセキュリティ」→「App管理」でTankardをオンにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会在 Tankard 安装、更新或移除“应用程序”中的 App 前询问。请在“隐私与安全性”→“App 管理”中打开 Tankard。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS pergunta antes que o Tankard possa instalar, atualizar ou remover apps em Aplicativos. Ative o Tankard em Privacidade e Segurança → Gerenciamento de Apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS chiede prima che Tankard possa installare, aggiornare o rimuovere app in Applicazioni. Attiva Tankard in Privacy e sicurezza → Gestione app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 Tankard가 응용 프로그램의 앱을 설치, 업데이트 또는 제거하기 전에 묻습니다. 개인정보 보호 및 보안 → 앱 관리에서 Tankard를 켜세요."
          }
        }
      }
    },
    "macOS asks before one app can change other apps, so Homebrew needs this to install, update or remove apps in Applications.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt, bevor eine App andere Apps ändern darf. Homebrew braucht das, um Apps zu installieren, aktualisieren oder entfernen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS demande avant qu’une app puisse modifier d’autres apps : Homebrew en a besoin pour installer, mettre à jour ou supprimer des apps dans Applications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS pregunta antes de que una app pueda cambiar otras apps, así que Homebrew lo necesita para instalar, actualizar o eliminar apps en Aplicaciones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSはアプリが他のアプリを変更する前に確認します。Homebrewが「アプリケーション」内のアプリをインストール、アップデート、削除するにはこの許可が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 会在一个 App 更改其他 App 前询问，因此 Homebrew 需要此权限才能在“应用程序”中安装、更新或移除 App。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS pergunta antes que um app possa alterar outros apps, então o Homebrew precisa disso para instalar, atualizar ou remover apps em Aplicativos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS chiede prima che un'app possa modificare altre app, quindi Homebrew ne ha bisogno per installare, aggiornare o rimuovere app in Applicazioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 한 앱이 다른 앱을 변경하기 전에 묻습니다. Homebrew가 응용 프로그램의 앱을 설치, 업데이트 또는 제거하려면 이 권한이 필요합니다."
          }
        }
      }
    },
    "macOS blocked changing an app": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hat eine App-Änderung blockiert"
          }
        },
        "fr": {
