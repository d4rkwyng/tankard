            "value": "安装时会从源码编译，这在较旧的 Mac 上可能需要很长时间。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar compila do código-fonte, o que pode demorar muito em Macs mais antigos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'installazione compila dai sorgenti, il che può richiedere molto tempo sui Mac meno recenti."
          }
