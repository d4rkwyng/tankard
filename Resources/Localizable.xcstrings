    "Switching back would change which version other programs see, so Tankard leaves it to you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Zurückwechseln würde ändern, welche Version andere Programme sehen, daher überlässt Tankard das dir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenir en arrière changerait la version que voient les autres programmes, donc Tankard vous laisse le faire."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver atrás cambiaría la versión que ven otros programas, así que Tankard lo deja en tus manos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tornare indietro cambierebbe la versione vista dagli altri programmi, quindi Tankard lascia decidere a te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元に戻すと、ほかのプログラムが使うバージョンが変わるため、Tankardはこの操作をあなたに任せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되돌리면 다른 프로그램이 보는 버전이 바뀌므로, Tankard는 이 작업을 사용자에게 맡깁니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换回去会改变其他程序看到的版本，因此 Tankard 把这一步交给你。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltar mudaria a versão que outros programas veem, então o Tankard deixa isso com você."
          }
        }
      }
    },
