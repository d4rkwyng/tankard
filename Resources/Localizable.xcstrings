        }
      }
    },
    "Set in brew.env, so it overrides Tankard's self-updating apps setting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In brew.env gesetzt: überschreibt Tankards Einstellung für selbstaktualisierende Apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défini dans brew.env : remplace le réglage de Tankard pour les apps qui se mettent à jour seules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Definido en brew.env: reemplaza el ajuste de Tankard para apps que se actualizan solas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brew.env で設定: Tankard の自動更新アプリの設定を上書きします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
