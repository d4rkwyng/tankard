    "Stop also unregisters it from launching at login.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Stoppen“ hebt auch die Registrierung für den Start bei der Anmeldung auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter le désenregistre aussi du lancement à l’ouverture de session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener también anula su registro para abrirse al iniciar sesión."
          }
        },
