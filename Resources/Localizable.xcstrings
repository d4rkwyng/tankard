    "1 installed package comes from this tap (%@). Uninstall it first; brew refuses to untap while they're installed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "1 installiertes Paket stammt aus diesem Tap (%@). Deinstalliere es zuerst; brew verweigert untap, solange es installiert ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "1 paquet installé provient de ce tap (%@). Désinstallez-le d’abord ; brew refuse de retirer un tap tant qu’ils sont installés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "1 paquete instalado proviene de este tap (%@). Desinstálalo primero; brew se niega a quitar el tap mientras estén instalados."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このtap(%@)から1個のインストール済みパッケージが来ています。先にアンインストールしてください。インストール済みの間は、brewはuntapを拒否します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个 tap（%@）提供了 1 个已安装的软件包。请先卸载它；只要它仍已安装，brew 就拒绝 untap。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "1 pacote instalado vem deste tap (%@). Desinstale-o primeiro; o brew se recusa a executar untap enquanto estiverem instalados."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 pacchetto installato proviene da questo tap (%@). Disinstallalo prima; brew rifiuta di rimuovere il tap finché è installato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 패키지 1개가 이 tap(%@)에서 왔습니다. 먼저 제거하세요. 설치되어 있는 동안에는 brew가 untap을 거부합니다."
          }
        }
      }
    },
