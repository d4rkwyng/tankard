    "Packages Homebrew installed only because something else needed them, and nothing needs anymore.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakete, die Homebrew nur installiert hat, weil etwas anderes sie brauchte, und die nichts mehr braucht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquets que Homebrew a installés uniquement parce qu’autre chose en avait besoin, et dont plus rien n’a besoin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquetes que Homebrew instaló solo porque otra cosa los necesitaba, y que ya nada necesita."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacchetti che Homebrew ha installato solo perché servivano a qualcos'altro, e che ormai non servono più a nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのものに必要だったためにHomebrewがインストールし、今はもう何にも必要とされていないパッケージです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 항목에 필요해서 Homebrew가 설치했지만 이제 아무것도 필요로 하지 않는 패키지입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 只是因为其他软件需要才安装、现在已不再被需要的软件包。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacotes que o Homebrew instalou só porque outro precisava deles, e que nada mais precisa."
          }
        }
      }
    },
    "Packages brew won't upgrade (brew pin)": {
      "localizations": {
        "de": {
