          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A última verificação (%@) não encontrou nenhuma."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ultima scansione (%@) non ne ha trovate."
          }
        },
        "ko": {
