    "Built from source; a bottle exists for the current version": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Quellcode gebaut; für die aktuelle Version gibt es eine Bottle"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compilé depuis les sources ; une bottle existe pour la version actuelle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compilado desde el código fuente; existe un bottle para la versión actual"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソースからビルド。現在のバージョンのbottleがあります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
