    "Click Open System Settings, then choose Privacy & Security → App Management.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf „Systemeinstellungen öffnen“ und wähle dann „Datenschutz & Sicherheit“ → „App-Verwaltung“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Ouvrir Réglages Système, puis choisissez Confidentialité et sécurité → Gestion des apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en Abrir Ajustes del Sistema y elige Privacidad y seguridad → Gestión de apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定を開く」をクリックし、「プライバシーとセキュリティ」→「App管理」を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“打开系统设置”，然后选择“隐私与安全性”→“App 管理”。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em Abrir Ajustes do Sistema e escolha Privacidade e Segurança → Gerenciamento de Apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su Apri Impostazioni di Sistema, poi scegli Privacy e sicurezza → Gestione app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 열기를 클릭한 다음 개인정보 보호 및 보안 → 앱 관리를 선택하세요."
          }
        }
      }
    },
    "Click Open System Settings. It opens Privacy & Security → App Management.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf „Systemeinstellungen öffnen“. Es öffnet „Datenschutz & Sicherheit“ → „App-Verwaltung“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Ouvrir Réglages Système. Cela ouvre Confidentialité et sécurité → Gestion des apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en Abrir Ajustes del Sistema. Se abre Privacidad y seguridad → Gestión de apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定を開く」をクリックします。「プライバシーとセキュリティ」→「App管理」が開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“打开系统设置”。它会打开“隐私与安全性”→“App 管理”。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em Abrir Ajustes do Sistema. Ele abre Privacidade e Segurança → Gerenciamento de Apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su Apri Impostazioni di Sistema. Si apre Privacy e sicurezza → Gestione app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 열기를 클릭하세요. 개인정보 보호 및 보안 → 앱 관리가 열립니다."
          }
        }
      }
    },
    "Click to read the notes Homebrew printed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken, um die Hinweise von Homebrew zu lesen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour lire les notes affichées par Homebrew."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para leer las notas de Homebrew."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックすると Homebrew が表示したメモを読めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按以阅读 Homebrew 显示的说明。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para ler as notas exibidas pelo Homebrew."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic per leggere le note mostrate da Homebrew."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하면 Homebrew가 출력한 안내를 읽을 수 있습니다."
          }
        }
      }
    },
    "Click to see what happened.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken, um zu sehen, was passiert ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour voir ce qui s'est passé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic para ver qué pasó."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックすると何が起きたかを確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按以查看发生了什么。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para ver o que aconteceu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic per vedere cosa è successo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하면 무슨 일이 있었는지 볼 수 있습니다."
          }
        }
      }
    },
