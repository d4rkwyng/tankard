            "state": "translated",
            "value": "Deixados de fora, alterados ou feitos desde então: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esclusi, cambiati o già fatti: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제외됨(이후 변경되었거나 완료됨): %@"
          }
        }
      }
    },
    "Left to the app: %@ isn't in Upgrade All or auto-update.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der App überlassen: %@ ist nicht in „Alle upgraden“ oder Auto-Update."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissée à l'app : %@ n'est pas inclus dans Tout mettre à niveau ni dans la mise à jour auto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La gestiona la app: %@ no está en Actualizar todo ni en la actualización automática."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリに任せる: %@ は「すべてアップグレード」と自動アップデートの対象外です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交由 App：%@ 不在“全部升级”或自动更新中。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixado ao app: %@ não está em Atualizar tudo nem na atualização automática."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lasciata all'app: %@ non è in Aggiorna tutto né nell'aggiornamento automatico."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에 맡김: %@은(는) 모두 업그레이드 및 자동 업데이트에 포함되지 않습니다."
          }
        }
      }
    },
    "Leftover links point at files that are gone. Usually harmless; brew cleanup removes most of them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übrig gebliebene Links zeigen auf nicht mehr vorhandene Dateien. Meist harmlos; brew cleanup entfernt die meisten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des liens résiduels pointent vers des fichiers disparus. Généralement sans danger ; brew cleanup en supprime la plupart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces sobrantes apuntan a archivos que ya no existen. Suele ser inofensivo; brew cleanup elimina la mayoría."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残ったリンクは、存在しないファイルを指しています。通常は問題ありません。brew cleanup でほとんど削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "残留的链接指向已不存在的文件。通常无害；brew cleanup 会移除其中大部分。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Links remanescentes apontam para arquivos que não existem mais. Geralmente inofensivo; brew cleanup remove a maioria."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I collegamenti residui puntano a file che non esistono più. Di solito innocui; brew cleanup ne rimuove la maggior parte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남은 링크가 사라진 파일을 가리킵니다. 대개 무해하며 brew cleanup이 대부분 제거합니다."
          }
        }
      }
    },
    "Let the current package finish, then skip the rest": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das aktuelle Paket beenden lassen, dann den Rest überspringen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
