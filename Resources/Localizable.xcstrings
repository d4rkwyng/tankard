          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew가 이 패키지를 읽을 수 없습니다"
          }
        }
      }
    },
    "Homebrew can't read this package any more, so it won't upgrade it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew kann dieses Paket nicht mehr lesen und aktualisiert es deshalb nicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ne peut plus lire ce paquet et ne le mettra donc pas à jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew ya no puede leer este paquete, así que no lo actualizará."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew はこのパッケージをもう読み込めないため、アップグレードしません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew 已无法读取此软件包，因此不会升级它。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Homebrew não consegue mais ler este pacote, então não vai atualizá-lo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew non riesce più a leggere questo pacchetto, quindi non lo aggiornerà."
          }
        },
