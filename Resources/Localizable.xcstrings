          }
        }
      }
    },
    "Set in brew.env, so it reaches Tankard's brew: automatic updates pause while it is set.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In brew.env gesetzt, erreicht Tankards brew: Auto-Updates pausieren, solange es gesetzt ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Défini dans brew.env, donc transmis au brew de Tankard : les mises à jour automatiques sont en pause tant qu'il est défini."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Definido en brew.env, así que llega al brew de Tankard: las actualizaciones automáticas se pausan mientras esté definido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brew.env で設定されているため Tankard の brew に届きます: 設定中は自動アップデートが一時停止します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 brew.env 中设置，因此会影响 Tankard 的 brew：设置期间自动更新会暂停。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Definido no brew.env, então chega ao brew do Tankard: as atualizações automáticas pausam enquanto estiver definido."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostato in brew.env, quindi arriva al brew di Tankard: gli aggiornamenti automatici restano in pausa finché è impostato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "brew.env에 설정되어 Tankard의 brew에 전달됨: 설정되어 있는 동안 자동 업데이트가 일시 중지됩니다."
          }
        }
      }
    },
    "Set in brew.env: Tankard's download progress and Clean Up assume the default folders.": {
      "localizations": {
        "de": {
          "stringUnit": {
