    "Add the taps first (Add Tap…), then check the Brewfile again to install the rest.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge zuerst die Taps hinzu (Tap hinzufügen…) und prüfe die Brewfile dann erneut, um den Rest zu installieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez d’abord les taps (Ajouter un tap…), puis vérifiez à nouveau le Brewfile pour installer le reste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade primero los taps (Añadir tap…) y vuelve a comprobar el Brewfile para instalar el resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずtapを追加し（「tapを追加…」）、それからBrewfileをもう一度確認して残りをインストールしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先添加这些 Tap（添加 Tap…），然后再次检查 Brewfile 以安装其余项目。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione primeiro os taps (Adicionar Tap…) e depois verifique o Brewfile de novo para instalar o resto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi prima i tap (Aggiungi tap…), poi controlla di nuovo il Brewfile per installare il resto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 tap을 추가한 다음(tap 추가…), Brewfile을 다시 확인해 나머지를 설치하세요."
          }
        }
      }
    },
    "Add, Remove and Trust go through Tankard's queue and History.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinzufügen, Entfernen und Vertrauen laufen über die Warteschlange und den Verlauf von Tankard."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter, Retirer et Approuver passent par la file d’attente et l’historique de Tankard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir, Quitar y Confiar pasan por la cola y el Historial de Tankard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加、削除、信頼はTankardのキューと履歴を通じて行われます。"
