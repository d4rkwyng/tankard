    "Restore never uninstalls what was added. Uninstall it from its details if you don't want it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Wiederherstellen“ deinstalliert nie, was hinzugefügt wurde. Deinstalliere es in den Details, wenn du es nicht möchtest."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration ne désinstalle jamais ce qui a été ajouté. Désinstallez-le depuis ses détails si vous n’en voulez pas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar nunca desinstala lo que se añadió. Desinstálalo desde sus detalles si no lo quieres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元しても、追加されたものはアンインストールされません。不要な場合は、詳細からアンインストールしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复不会卸载后来新增的内容。若不需要，请在其详情中卸载。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar nunca desinstala o que foi adicionado. Desinstale-o pelos detalhes se não o quiser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ripristino non disinstalla mai ciò che è stato aggiunto. Disinstallalo dai suoi dettagli se non lo vuoi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원해도 추가된 항목은 제거되지 않습니다. 필요 없으면 세부 정보에서 제거하세요."
          }
        }
      }
    },
