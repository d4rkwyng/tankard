        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi il controllo di sicurezza. L'ultimo risultato viene conservato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティチェックを停止します。前回の結果は残ります。"
