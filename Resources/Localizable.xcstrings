    "Quit Tankard and open it again to use the new version.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beende Tankard und öffne es erneut, um die neue Version zu nutzen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez Tankard et rouvrez-le pour utiliser la nouvelle version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sal de Tankard y vuelve a abrirlo para usar la nueva versión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンを使うには、Tankardを終了してもう一度開いてください。"
