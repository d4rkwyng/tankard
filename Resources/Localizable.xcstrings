    "Other installed packages need the current version, and Homebrew can't give them an older one.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere installierte Pakete brauchen die aktuelle Version, und Homebrew kann ihnen keine ältere geben."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’autres paquets installés ont besoin de la version actuelle, et Homebrew ne peut pas leur en fournir une plus ancienne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros paquetes instalados necesitan la versión actual, y Homebrew no puede darles una anterior."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altri pacchetti installati richiedono la versione attuale, e Homebrew non può dar loro una versione precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのインストール済みパッケージが現在のバージョンを必要としており、Homebrewはそれらに古いバージョンを渡せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 다른 패키지에 현재 버전이 필요하며, Homebrew는 그 패키지들에 이전 버전을 제공할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他已安装的软件包需要当前版本，而 Homebrew 无法为它们提供旧版本。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outros pacotes instalados precisam da versão atual, e o Homebrew não consegue fornecer uma versão mais antiga a eles."
          }
        }
      }
    },
