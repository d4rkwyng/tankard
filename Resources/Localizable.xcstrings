    "brew refuses to uninstall a formula other installed packages need, and Homebrew doesn't support mixing versions under them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "brew weigert sich, eine Formula zu deinstallieren, die andere installierte Pakete benötigen, und Homebrew unterstützt kein Mischen von Versionen darunter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "brew refuse de désinstaller une formula dont d’autres paquets installés ont besoin, et Homebrew ne prend pas en charge le mélange de versions sous eux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "brew se niega a desinstalar una formula que otros paquetes instalados necesitan, y Homebrew no admite mezclar versiones debajo de ellos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "brewは、他のインストール済みパッケージが必要とするformulaのアンインストールを拒否します。また、Homebrewはその下でバージョンを混在させることをサポートしていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "brew 拒绝卸载其他已安装软件包所需的 formula，且 Homebrew 不支持在其下混用不同版本。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O brew se recusa a desinstalar uma formula de que outros pacotes instalados precisam, e o Homebrew não permite misturar versões sob eles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "brew rifiuta di disinstallare una formula di cui hanno bisogno altri pacchetti installati, e Homebrew non supporta il mix di versioni sotto di essi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "brew는 설치된 다른 패키지가 필요로 하는 formula의 제거를 거부하며, Homebrew는 그 아래에서 버전을 섞는 것을 지원하지 않습니다."
          }
        }
      }
    },
