          "stringUnit": {
            "state": "translated",
            "value": "显示 Tankard 上次读取的数据。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando os últimos dados lidos pelo Tankard."
          }
        },
        "it": {
