    "Old versions, stale downloads and old logs. The versions you use now stay installed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte Versionen, veraltete Downloads und alte Protokolle. Die Versionen, die du jetzt verwendest, bleiben installiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anciennes versions, téléchargements obsolètes et anciens journaux. Les versions que vous utilisez restent installées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiones antiguas, descargas obsoletas y registros antiguos. Las versiones que usas ahora siguen instaladas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いバージョン、不要なダウンロード、古いログ。いま使っているバージョンはインストールされたままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版本、过期的下载和旧日志。你现在使用的版本会保持安装。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Versões antigas, downloads obsoletos e logs antigos. As versões que você usa agora continuam instaladas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vecchie versioni, download obsoleti e vecchi log. Le versioni che usi ora restano installate."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 버전, 오래된 다운로드, 오래된 로그입니다. 지금 사용 중인 버전은 설치된 채로 남습니다."
          }
        }
      }
    },
