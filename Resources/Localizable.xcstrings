            "state": "translated",
            "value": "Entfernt %@ %@. Die Abhängigkeiten bleiben installiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime %@ %@. Ses dépendances restent installées."
          }
        },
