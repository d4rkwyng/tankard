    "Click Open System Settings, then choose Privacy & Security → App Management.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf „Systemeinstellungen öffnen“ und wähle dann „Datenschutz & Sicherheit“ → „App-Verwaltung“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Ouvrir Réglages Système, puis choisissez Confidentialité et sécurité → Gestion des apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en Abrir Ajustes del Sistema y elige Privacidad y seguridad → Gestión de apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定を開く」をクリックし、「プライバシーとセキュリティ」→「App管理」を選択してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“打开系统设置”，然后选择“隐私与安全性”→“App 管理”。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em Abrir Ajustes do Sistema e escolha Privacidade e Segurança → Gerenciamento de Apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su Apri Impostazioni di Sistema, poi scegli Privacy e sicurezza → Gestione app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 열기를 클릭한 다음 개인정보 보호 및 보안 → 앱 관리를 선택하세요."
          }
        }
      }
    },
    "Click Open System Settings. It opens Privacy & Security → App Management.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf „Systemeinstellungen öffnen“. Es öffnet „Datenschutz & Sicherheit“ → „App-Verwaltung“."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Ouvrir Réglages Système. Cela ouvre Confidentialité et sécurité → Gestion des apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en Abrir Ajustes del Sistema. Se abre Privacidad y seguridad → Gestión de apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定を開く」をクリックします。「プライバシーとセキュリティ」→「App管理」が開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按“打开系统设置”。它会打开“隐私与安全性”→“App 管理”。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em Abrir Ajustes do Sistema. Ele abre Privacidade e Segurança → Gerenciamento de Apps."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su Apri Impostazioni di Sistema. Si apre Privacy e sicurezza → Gestione app."
          }
        },
        "ko": {
