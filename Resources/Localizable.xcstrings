    "Tries a harmless write in an app Homebrew installed, as Homebrew does, and removes it at once": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibt testweise in eine Homebrew-App, wie Homebrew selbst, und entfernt es sofort"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente une écriture sans risque dans une app installée par Homebrew, comme Homebrew, et la supprime aussitôt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba una escritura inofensiva en una app instalada por Homebrew, como hace Homebrew, y la elimina al instante"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrewと同じように、Homebrewでインストールしたアプリに無害な書き込みを試し、すぐに削除します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像 Homebrew 一样，在 Homebrew 安装的 App 中尝试一次无害写入，并立即移除"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenta uma gravação inofensiva em um app instalado pelo Homebrew, como o Homebrew faz, e a remove na hora"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova una scrittura innocua in un'app installata da Homebrew, come fa Homebrew, e la rimuove subito"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew처럼 Homebrew가 설치한 앱에 무해한 쓰기를 시도하고 바로 제거합니다"
          }
        }
      }
    },
