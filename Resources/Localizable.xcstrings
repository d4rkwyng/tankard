    "Old versions, stale downloads and old logs. Nothing you use is removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte Versionen, veraltete Downloads und alte Protokolle. Nichts, was du verwendest, wird entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anciennes versions, téléchargements obsolètes et anciens journaux. Rien de ce que vous utilisez n’est supprimé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versiones antiguas, descargas obsoletas y registros antiguos. No se elimina nada que uses."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いバージョン、不要なダウンロード、古いログ。使用中のものは削除されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
