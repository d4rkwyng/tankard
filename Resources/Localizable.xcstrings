          }
        }
      }
    },
    "Nothing installed comes from it. brew deletes its local copy and stops trusting it; if you add it again later, Tankard asks again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts Installiertes stammt daraus. brew löscht die lokale Kopie und vertraut dem Tap nicht mehr; fügst du ihn später wieder hinzu, fragt Tankard erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d’installé n’en provient. brew supprime sa copie locale et cesse de lui faire confiance ; si vous l’ajoutez à nouveau plus tard, Tankard vous le redemandera."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de lo instalado viene de él. brew borra su copia local y deja de confiar en él; si lo vuelves a añadir más adelante, Tankard volverá a preguntar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのものでこのtapから来たものはありません。brewはローカルのコピーを削除し、このtapの信頼も解除します。後でもう一度追加すると、Tankardは再び確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已安装的内容来自它。brew 会删除其本地副本并不再信任它；以后再次添加时，Tankard 会再次询问。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada instalado vem dele. O brew apaga a cópia local e deixa de confiar nele; se você adicioná-lo de novo depois, o Tankard pergunta outra vez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla di installato proviene da qui. brew elimina la copia locale e smette di considerarlo attendibile; se lo aggiungi di nuovo in seguito, Tankard lo chiede di nuovo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 항목 중 이 tap에서 온 것은 없습니다. brew가 로컬 사본을 삭제하고 이 tap을 더 이상 신뢰하지 않습니다. 나중에 다시 추가하면 Tankard가 다시 묻습니다."
          }
        }
      }
    },
    "Nothing installed comes from it. brew deletes its local copy; you can add it again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts Installiertes stammt daraus. brew löscht die lokale Kopie; du kannst den Tap später wieder hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d’installé n’en provient. brew supprime sa copie locale ; vous pourrez l’ajouter à nouveau plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de lo instalado viene de él. brew borra su copia local; puedes volver a añadirlo más adelante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのものでこのtapから来たものはありません。brewはローカルのコピーを削除します。後でもう一度追加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已安装的内容来自它。brew 会删除其本地副本；你以后可以再次添加。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada instalado vem dele. O brew apaga a cópia local; você pode adicioná-lo de novo depois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla di installato proviene da qui. brew elimina la copia locale; potrai aggiungerlo di nuovo in seguito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 항목 중 이 tap에서 온 것은 없습니다. brew가 로컬 사본을 삭제합니다. 나중에 다시 추가할 수 있습니다."
          }
