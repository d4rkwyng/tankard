    "Not edited: removing line %@ would leave an empty if, loop or { } block, which bash rejects. Remove the lines by hand (or put : in the block) after the revert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht bearbeitet: Das Entfernen von Zeile %@ würde einen leeren if-, Schleifen- oder { }-Block hinterlassen, den bash ablehnt. Entferne die Zeilen nach dem Zurücksetzen von Hand (oder setze : in den Block)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non modifié : supprimer la ligne %@ laisserait un bloc if, boucle ou { } vide, que bash rejette. Supprimez les lignes manuellement (ou mettez : dans le bloc) après le retour en arrière."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No editado: quitar la línea %@ dejaría un bloque if, bucle o { } vacío, que bash rechaza. Quita las líneas manualmente (o pon : en el bloque) tras la reversión."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集しませんでした: %@行目を削除すると、bashが拒否する空のif、ループ、{ } ブロックが残ります。元に戻した後で、手動で行を削除してください(またはブロックに : を入れてください)。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未编辑：移除第 %@ 行会留下空的 if、循环或 { } 块，bash 会拒绝它。请在还原后手动移除这些行（或在块中放入 :）。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não editado: remover a linha %@ deixaria um bloco if, loop ou { } vazio, que o bash rejeita. Remova as linhas manualmente (ou coloque : no bloco) após a reversão."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non modificato: rimuovere la riga %@ lascerebbe un blocco if, ciclo o { } vuoto, che bash rifiuta. Rimuovi le righe manualmente (o metti : nel blocco) dopo il ripristino."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집되지 않음: %@번째 줄을 제거하면 빈 if, 반복문 또는 { } 블록이 남아 bash가 거부합니다. 되돌린 후 줄을 직접 제거하세요(또는 블록에 :를 넣으세요)."
          }
        }
      }
    },
