      }
    },
    "Tankard relaunched so macOS applies App Management. Nothing runs until you click Run Again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard wurde neu gestartet, damit macOS die App-Verwaltung anwendet. Nichts läuft, bevor du „Erneut ausführen“ klickst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard a été relancé pour que macOS applique Gestion des apps. Rien ne s’exécute avant que vous cliquiez sur Relancer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard se reinició para que macOS aplique Gestión de apps. No se ejecuta nada hasta que hagas clic en Ejecutar de nuevo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSがApp管理を適用できるようTankardを再起動しました。「もう一度実行」をクリックするまで何も実行されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 已重新启动，以便 macOS 应用“App 管理”。在你点按“再次运行”之前不会运行任何操作。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard foi reaberto para o macOS aplicar o Gerenciamento de Apps. Nada é executado até você clicar em Executar de novo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard è stato riavviato perché macOS applichi Gestione app. Non parte nulla finché non fai clic su Esegui di nuovo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS가 앱 관리를 적용하도록 Tankard를 다시 시작했습니다. 다시 실행을 클릭하기 전에는 아무것도 실행되지 않습니다."
          }
        }
      }
    },
    "Tankard runs brew update in the background so the counts stay fresh. Settings ▸ General turns it off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard führt brew update im Hintergrund aus, damit die Zahlen aktuell bleiben. Abschalten unter Einstellungen ▸ Allgemein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard exécute brew update en arrière-plan pour garder les chiffres à jour. Réglages ▸ Général permet de le désactiver."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard ejecuta brew update en segundo plano para que los números estén al día. Se desactiva en Ajustes ▸ General."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankardは数を最新に保つためにバックグラウンドでbrew updateを実行します。「設定」▸「一般」でオフにできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard 会在后台运行 brew update，让数量保持最新。可在“设置”▸“通用”中关闭。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tankard executa brew update em segundo plano para manter os números atualizados. Desative em Ajustes ▸ Geral."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard esegue brew update in background per tenere aggiornati i conteggi. Si disattiva in Impostazioni ▸ Generali."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tankard는 개수를 최신으로 유지하기 위해 백그라운드에서 brew update를 실행합니다. 설정 ▸ 일반에서 끌 수 있습니다."
          }
        }
      }
    },
